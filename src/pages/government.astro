---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { SERVICE_CATEGORIES } from '../data/services';
---

<BaseLayout
  title="Government & Municipal Offices | Municipality of Valencia, Bohol"
  description="Executive leadership, Sangguniang Bayan legislative functions, BARUG Valencia governance framework, and municipal department directory in Valencia, Bohol."
>
  <PageIntro
    eyebrow="Local Government Unit · Valencia, Bohol"
    title="Government & Municipal Offices"
    description="Guided by the BARUG VALENCIA framework—Better, Affectionate, Responsive and Unifying Governance—the Municipal Government coordinates public services across 35 barangays."
    asideTitle="Municipal Hall"
    aside="Located in Poblacion, Valencia, Bohol. Office hours follow regular weekday Philippine government schedules."
  />

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Executive & Legislative Branches</p>
          <h2>Municipal Governance Structure</h2>
          <p class="section-description">
            Local administration and policy-making operate under the Local Government Code of the Philippines (Republic Act No. 7160).
          </p>
        </div>
        <a href="/services" class="text-link">Browse resident service guides</a>
      </div>

      <div class="two-col">
        <div class="info-card">
          <span class="tag">Executive Branch</span>
          <h3 style="margin-top: 14px;">Office of the Municipal Mayor</h3>
          <p>
            Led by Municipal Mayor <strong>Dionisio Neil A. Balite</strong> (sworn into office in June 2025; completed the Development Academy of the Philippines AI Governance course in October 2026), the Executive Office oversees municipal departments, infrastructure delivery, disaster preparedness, and inter-agency programs under the <strong>BARUG VALENCIA</strong> agenda.
          </p>
          <a href="/projects">View municipal development programs →</a>
        </div>

        <div class="info-card">
          <span class="tag">Legislative Branch</span>
          <h3 style="margin-top: 14px;">Sangguniang Bayan</h3>
          <p>
            The municipal legislative council enacts ordinances, approves annual and supplemental budgets, reviews barangay development measures, and establishes local regulatory frameworks for Valencia’s 35 barangays. Youth representation sits through the Sangguniang Kabataan Municipal Federation.
          </p>
          <a href="/transparency">View public disclosure portals →</a>
        </div>
      </div>

      <!-- Municipal Hall Floor & Office Navigator -->
      <div class="floor-directory-card" style="margin-top: 52px; background: #ffffff; border: 1px solid var(--valencia-orange-border); border-top: 4px solid var(--valencia-orange); border-radius: 8px; padding: 28px; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
        <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 20px;">
          <div>
            <span class="badge badge-orange" style="font-size: 0.76rem; margin-bottom: 6px; display: inline-block;">Municipal Hall Navigator</span>
            <h3 style="margin: 0; font-size: 1.35rem; color: var(--forest);">Valencia Municipal Hall Floor & Window Directory</h3>
          </div>
          <span style="font-size: 0.82rem; color: var(--muted);">Poblacion, Valencia, Bohol · Mon–Fri 8:00 AM – 5:00 PM</span>
        </div>

        <div class="floor-layout" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
          <!-- Ground Floor -->
          <div style="background: var(--mint); border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; border-bottom: 1px solid var(--line); padding-bottom: 10px;">
              <strong style="color: var(--forest); font-size: 1.05rem;">Ground Floor (Frontline Windows)</strong>
              <span class="badge badge-orange" style="font-size: 0.72rem;">High Foot-Traffic</span>
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem; border-bottom: 1px dashed var(--line); padding-bottom: 8px;">
                <div>
                  <strong style="color: var(--ink); display: block;">Municipal Treasury Windows (Windows 1–4)</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">RPT (Land Tax), Business Tax, Cedula, Official Receipts</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">Treasurer</span>
              </li>
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem; border-bottom: 1px dashed var(--line); padding-bottom: 8px;">
                <div>
                  <strong style="color: var(--ink); display: block;">Office of the Municipal Assessor</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">Property appraisal, Tax Declarations, transfers</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">Assessor</span>
              </li>
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem; border-bottom: 1px dashed var(--line); padding-bottom: 8px;">
                <div>
                  <strong style="color: var(--ink); display: block;">Office of the Municipal Civil Registrar (MCR)</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">Birth/Marriage/Death registrations, PSA endorsements</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">Civil Registrar</span>
              </li>
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem; border-bottom: 1px dashed var(--line); padding-bottom: 8px;">
                <div>
                  <strong style="color: var(--ink); display: block;">Business Permits & Licensing Office (BPLO)</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">Mayor’s Permits, Paleng-QR vendor coordination</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">BPLO</span>
              </li>
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem;">
                <div>
                  <strong style="color: var(--ink); display: block;">MSWDO Assistance Desk</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">AICS medical/burial aid, Senior Citizen & PWD IDs</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">Social Welfare</span>
              </li>
            </ul>
          </div>

          <!-- Second Floor -->
          <div style="background: var(--mint); border: 1px solid var(--line); border-radius: 8px; padding: 20px;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; border-bottom: 1px solid var(--line); padding-bottom: 10px;">
              <strong style="color: var(--forest); font-size: 1.05rem;">Second Floor (Executive & Legislative)</strong>
              <span class="tag" style="font-size: 0.72rem;">Executive & Council</span>
            </div>
            <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem; border-bottom: 1px dashed var(--line); padding-bottom: 8px;">
                <div>
                  <strong style="color: var(--ink); display: block;">Office of the Municipal Mayor</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">Executive administration, appointments, BARUG Valencia</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">Mayor</span>
              </li>
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem; border-bottom: 1px dashed var(--line); padding-bottom: 8px;">
                <div>
                  <strong style="color: var(--ink); display: block;">Office of the Municipal Vice Mayor & SB</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">Legislative council, municipal ordinances & resolutions</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">Vice Mayor</span>
              </li>
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem; border-bottom: 1px dashed var(--line); padding-bottom: 8px;">
                <div>
                  <strong style="color: var(--ink); display: block;">Sangguniang Bayan Session Hall</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">Official public council hearings and committee sessions</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">SB Hall</span>
              </li>
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem; border-bottom: 1px dashed var(--line); padding-bottom: 8px;">
                <div>
                  <strong style="color: var(--ink); display: block;">Municipal Planning & Development (MPDC)</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">Zoning, comprehensive land use, municipal investments</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">MPDC</span>
              </li>
              <li style="display: flex; justify-content: space-between; align-items: baseline; font-size: 0.86rem;">
                <div>
                  <strong style="color: var(--ink); display: block;">Municipal Engineering & Building Office</strong>
                  <span style="color: var(--muted); font-size: 0.78rem;">Building permits, electrical & structural inspections</span>
                </div>
                <span class="tag" style="font-size: 0.7rem;">Engineering</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="section-heading" style="margin-top: 56px;">
        <div>
          <p class="section-kicker">Department Directory</p>
          <h2>Frontline Municipal Offices</h2>
          <p class="section-description">
            Find the responsible municipal office for civil registry, business licensing, tax collection, social welfare, rural health, agriculture, and tourism.
          </p>
        </div>
      </div>

      <div class="two-col">
        {SERVICE_CATEGORIES.map((s) => (
          <div class="info-card" id={s.id}>
            <span class="tag muted">{s.charterStatus}</span>
            <h3 style="margin-top: 14px;">{s.office}</h3>
            <p>{s.summary}</p>
            <a href={`/services/${s.id}`}>View service guide & requirements →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-stone">
    <div class="container">
      <div class="contact-strip">
        <div>
          <p class="section-kicker">Public Inquiries & Coordination</p>
          <h2>Verify Schedules & Documentary Checklists</h2>
          <p class="section-description">
            For specific Citizen’s Charter schedules, tax assessments, or mayor’s office appointments, coordinate in person at Valencia Municipal Hall or through the official LGU communication page.
          </p>
        </div>
        <div class="contact-actions">
          <a href="/contact" class="btn btn-primary">Official Channels & Directions</a>
          <a href="/transparency" class="btn btn-outline">Transparency Gateways</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
