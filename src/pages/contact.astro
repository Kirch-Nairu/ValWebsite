---
import BaseLayout from '../layouts/BaseLayout.astro';
import { OFFICIAL_CHANNELS, MEDIA_SLOTS } from '../data/valenciaData';

const prioritySocialChannels = OFFICIAL_CHANNELS.slice(0, 3);
const mediaList = Object.values(MEDIA_SLOTS);
---

<BaseLayout
  title="Contact, Official Channels & Media/Brand Provenance"
  description="Verified public communication channels for Valencia, Bohol (LGU Valencia Facebook page, Sang-at Festival page, SK Federation page) and photo/brand permission workflow."
>
  <section class="section-block section-deep">
    <div class="container">
      <span class="eyebrow eyebrow-light">Contact &amp; Official Channels · Municipality of Valencia, Bohol</span>
      <h1 class="display-hero" style="font-size: clamp(2rem, 4.2vw, 3.4rem);">
        Verified Municipal Channels &amp; Rights Provenance
      </h1>
      <p class="lead-paragraph">
        Because this website is an independent prototype (`VAL-M01B`), it never invents telephone hotlines, email addresses, office hours, or fake contact forms that pretend to deliver messages to Municipal Hall. Instead, it connects you directly to the verified public channels supplied by the project owner.
      </p>
    </div>
  </section>

  <!-- Three Priority User-Supplied Facebook Channels -->
  <section class="section-block">
    <div class="container">
      <span class="eyebrow">Direct Public Channels (`FB-001`, `FB-002`, `FB-003`)</span>
      <h2 class="section-title" style="margin-bottom: 1.5rem;">Official &amp; Community Social Pages</h2>

      <div class="grid-3">
        {prioritySocialChannels.map((ch) => (
          <article class="editorial-card" style="padding: 1.5rem;">
            <span class="badge badge-established">{ch.id} · Verified Metadata</span>
            <h3 style="font-size: 1.3rem; margin: 0.45rem 0;">{ch.name}</h3>
            <p style="margin: 0 0 0.65rem 0; font-size: 0.9rem; color: var(--ink-secondary);">{ch.role}</p>
            <p style="margin: 0 0 1rem 0; font-size: 0.88rem; color: var(--ink-primary);">{ch.scope}</p>
            <div style="margin-top: auto; padding-top: 0.85rem; border-top: 1px solid var(--border-subtle);">
              <a
                href={ch.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-dark"
                style="width: 100%;"
              >
                Open Page on Facebook ↗
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="callout-box" style="margin-top: 2rem;">
        <strong>Why There Is No Web Form on This Page:</strong> In accordance with engineering boundaries (`Issue #5`), an unauthenticated static prototype must not display a dead contact form or impersonate official LGU intake. For official municipal transactions, visit the <strong>Valencia Municipal Hall in Poblacion, Valencia, Bohol</strong> or message the official LGU page (`FB-001`) above.
      </div>
    </div>
  </section>

  <!-- PIO & Brand/Media Clearance Checklist -->
  <section class="section-block section-sand" id="pio-requests">
    <div class="container">
      <div class="grid-2" style="align-items: start;">
        <div>
          <span class="eyebrow">For the Municipal PIO, Tourism Office &amp; Creators</span>
          <h2 class="section-title" style="font-size: 1.75rem;">Official Brand &amp; Photography Clearance Checklist</h2>
          <p style="color: var(--ink-secondary);">
            To transition this prototype from an art-directed preview to an officially endorsed municipal publication, the following six authorizations are requested from the Municipality of Valencia (`research/barug-identity-audit.md` &amp; `research/photo-request-list.md`):
          </p>
          <ol style="padding-left: 1.25rem; color: var(--ink-primary); display: flex; flex-direction: column; gap: 0.6rem;">
            <li>
              <strong>Official Municipal Seal Vector:</strong> Authoritative SVG/EPS artwork and Sangguniang Bayan usage conditions (`R001`, `R015`).
            </li>
            <li>
              <strong>BARUG VALENCIA Brand Manual:</strong> Official wordmark lockup, approved color values, typography, and confirmation of the official acronym wording ("Unifying" vs. "Unified").
            </li>
            <li>
              <strong>High-Resolution Photography &amp; Releases:</strong> Permission-cleared originals (≥3000px) for the Panangatan river mouth, Sang-at Festival (`R007`, `R011`, `R019`), Sto. Niño Church floor (`R005`), Badiang Spring (`R021`), and Anoyon classroom turnover (`R006`).
            </li>
            <li>
              <strong>Current RA 11032 Citizen’s Charter:</strong> Signed current edition replacing the historical 2015 archive.
            </li>
            <li>
              <strong>Verified Office Directory &amp; Hotlines:</strong> Current MDRRMO emergency numbers, RHU contacts, and department emails.
            </li>
            <li>
              <strong>Historical Date Confirmation:</strong> Official resolution on the 1867 vs. October 27, 1869 founding date and 2022 vs. 2023 Sang-at Festival inauguration.
            </li>
          </ol>
        </div>

        <div class="editorial-card" style="padding: 1.5rem;">
          <span class="eyebrow">Drop-In Media Replacement Architecture</span>
          <h3 style="font-size: 1.3rem; margin-bottom: 0.5rem;">How Approved Photos Replace Prototype Slots</h3>
          <p style="font-size: 0.9rem; color: var(--ink-secondary);">
            Every visual slot across this website is powered by <code>src/components/ValenciaMediaSlot.astro</code> and indexed in <code>src/data/valenciaData.ts</code>. Once written permission is documented:
          </p>
          <ul style="font-size: 0.88rem; color: var(--ink-secondary); padding-left: 1.2rem; display: flex; flex-direction: column; gap: 0.45rem;">
            <li>Place the permission-cleared image file in <code>public/media/approved/</code> matching the slot’s target path.</li>
            <li>Update the slot’s <code>approvalStatus</code> and photographer credit line in <code>src/data/valenciaData.ts</code>.</li>
            <li>Zero page layouts or responsive components require refactoring.</li>
          </ul>
          <div style="margin-top: 1rem; padding: 0.85rem; background: var(--bg-ivory); border-radius: var(--radius-sm); font-family: var(--font-mono); font-size: 0.76rem;">
            <div>Current Rights-Cleared Third-Party Binaries Committed: <strong>0</strong></div>
            <div>Art-Directed Valencia SVG Slots Active: <strong>{mediaList.length}</strong></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Media Slot Manifest Table -->
  <section class="section-block">
    <div class="container">
      <span class="eyebrow">Asset Provenance Ledger</span>
      <h2 class="section-title" style="font-size: 1.65rem; margin-bottom: 1.25rem;">Active Visual Slots &amp; Acquisition Targets</h2>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>Slot ID</th>
              <th>Candidate Ref</th>
              <th>Valencia Subject &amp; Barangay</th>
              <th>Current Status</th>
              <th>Drop-In Target Path</th>
              <th>Next Acquisition Action</th>
            </tr>
          </thead>
          <tbody>
            {mediaList.map((m) => (
              <tr>
                <td style="font-family: var(--font-mono);"><strong>{m.slotId}</strong></td>
                <td style="font-family: var(--font-mono);">{m.candidateId}</td>
                <td>
                  <strong>{m.title}</strong>
                  <div style="font-size: 0.8rem; color: var(--ink-muted);">{m.barangay}</div>
                </td>
                <td><span class="badge badge-potential">{m.statusLabel}</span></td>
                <td style="font-family: var(--font-mono); font-size: 0.8rem;">{m.approvedDropInPath}</td>
                <td style="font-size: 0.84rem;">{m.acquisitionNote}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
