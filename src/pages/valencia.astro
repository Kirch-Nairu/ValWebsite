---
import BaseLayout from '../layouts/BaseLayout.astro';
import ValenciaMediaSlot from '../components/ValenciaMediaSlot.astro';
import { SITE_META, BARANGAYS, CONFLICTS_SUMMARY } from '../data/valenciaData';
---

<BaseLayout
  title="Our Valencia — Municipal Profile, Geography & All 35 Barangays"
  description="Verified municipal profile for Valencia, Bohol (PSGC 0701247000): 2024 census population (28,535), Panangatan history, BARUG VALENCIA catchphrase audit, and all 35 barangays."
>
  <section class="section-block section-deep">
    <div class="container">
      <span class="eyebrow eyebrow-light">Our Valencia · Municipal Profile &amp; Geography</span>
      <h1 class="display-hero" style="font-size: clamp(2rem, 4.2vw, 3.4rem);">
        Municipality of Valencia, Province of Bohol
      </h1>
      <p class="lead-paragraph">
        Located on the southern coast of Bohol in the 3rd Congressional District, Valencia (PSGC <code>{SITE_META.psgcCode}</code>) bridges coastal fishing villages along the Bohol Sea and interior limestone highlands rising to 485 meters. Per the 2024 Philippine Statistics Authority census (`S013`), the municipality is home to <strong>{SITE_META.population2024} residents</strong> across <strong>{SITE_META.barangayCount} barangays</strong>.
      </p>
    </div>
  </section>

  <!-- Identity, History & BARUG Audit -->
  <section class="section-block">
    <div class="container grid-2" style="align-items: start;">
      <div>
        <span class="eyebrow">Etymology &amp; Historical Record</span>
        <h2 class="section-title" style="font-size: 1.85rem;">From Barrio Panangatan to Valencia</h2>
        <p>
          Before its establishment as an independent town, Valencia was known as <strong>Panangatan</strong>—a barrio under neighboring Dimiao (`S024`, `S025`). The name derives from the Cebuano root word <em>sang-at</em> ("to put up on an elevated place"), referring to how fishermen from Dimiao and Lila hauled their wooden boats up onto the nipa-fringed banks of the Panangatan River for shelter during the southwest monsoon (<em>habagat</em>).
        </p>
        <div class="callout-box" style="margin-block: 1.15rem;">
          <strong>Founding Date Variance (`C1` — Disclosed, Not Silently Resolved):</strong>
          <ul style="margin: 0.45rem 0 0 0; padding-left: 1.2rem;">
            <li>
              <strong>October 27, 1869:</strong> The Bohol PPDO CY2025 Tourism Profile (pp. 194–195, `S024`) and parish chronicles record that Panangatan and adjacent barrios were instituted as a town on October 27, 1869 (and became an independent parish under the Augustinian Recollects in 1871).
            </li>
            <li>
              <strong>1867:</strong> Wikipedia’s general history paragraph (`S025`) states Panangatan remained part of Dimiao until 1867 when a Spanish priest was assigned and renamed the town after Valencia, Spain.
            </li>
          </ul>
        </div>
        <p>
          By 1879, Valencia recorded a population of 7,009 (`S025`). Its livelihood rests on coconut, rice, corn, root crops, coastal fishing, traditional household weaving and pottery, and the weekly Sunday <em>Tabu</em> market.
        </p>
      </div>

      <div>
        <ValenciaMediaSlot slotId="hero-panangatan" />
        <div class="editorial-card" style="padding: 1.35rem; margin-top: 1.25rem;">
          <span class="eyebrow">Brand &amp; Catchphrase Provenance (`docs/06`)</span>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.45rem;">BARUG VALENCIA</h3>
          <p style="margin: 0 0 0.65rem 0; font-size: 0.92rem; color: var(--ink-secondary);">
            {SITE_META.catchphraseNote}
          </p>
          <p style="margin: 0; font-size: 0.84rem; color: var(--ink-muted);">
            <strong>Seal &amp; Color Governance:</strong> While Wikimedia Commons hosts a 2021 municipal flag file (`R001`), Philippine government insignia rules restrict unauthorized seal reproduction. This prototype uses a neutral typographic emblem until the LGU PIO supplies an authorized vector seal and brand manual.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete 35 Barangays Directory with Interactive Filter -->
  <section class="section-block section-sand" id="barangays">
    <div class="container">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 1.25rem;">
        <div>
          <span class="eyebrow">PSA PSGC Registry (`0701247000` · Source `S013` &amp; `S025`)</span>
          <h2 class="section-title" style="margin-bottom: 0.25rem;">All 35 Verified Barangays of Valencia, Bohol</h2>
          <p style="margin: 0; color: var(--ink-secondary);">
            Every barangay below is verified against the Philippine Standard Geographic Code (PSGC `071247001`–`071247035`). Individual 2024 barangay population counts and current Punong Barangay rosters await official LGU directory release.
          </p>
        </div>
        <div>
          <label for="barangay-search" style="font-weight: 700; font-size: 0.85rem; display: block; margin-bottom: 0.25rem;">
            Filter 35 Barangays:
          </label>
          <input
            type="search"
            id="barangay-search"
            placeholder="Type barangay name (e.g. Anas, Anoyon)..."
            style="padding: 0.5rem 0.85rem; border-radius: var(--radius-sm); border: 1.5px solid var(--border-strong); background: #fff; min-width: 17rem;"
          />
        </div>
      </div>

      <div class="table-scroll">
        <table class="data-table" id="barangay-table">
          <thead>
            <tr>
              <th>#</th>
              <th>PSGC Code</th>
              <th>Barangay Name</th>
              <th>Geographic Corridor</th>
              <th>Documented Features / Research References</th>
            </tr>
          </thead>
          <tbody>
            {BARANGAYS.map((b, i) => (
              <tr data-barangay-row data-name={`${b.name} ${b.zone} ${b.notableFeatures}`.toLowerCase()}>
                <td>{i + 1}</td>
                <td style="font-family: var(--font-mono);">{b.psgc}</td>
                <td><strong>{b.name}</strong></td>
                <td>{b.zone}</td>
                <td>{b.notableFeatures}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Source Conflicts & Disambiguation Ledger -->
  <section class="section-block">
    <div class="container">
      <span class="eyebrow">Editorial Integrity &amp; Disambiguation (`research/conflicts-and-gaps.md`)</span>
      <h2 class="section-title" style="font-size: 1.75rem;">Documented Historical &amp; Source Variances</h2>
      <p style="color: var(--ink-secondary); margin-bottom: 1.5rem;">
        Rather than silently picking a convenient date or copying records from other municipalities named Valencia (such as Valencia City, Bukidnon or Valencia, Negros Oriental), this prototype documents every public-source conflict transparently.
      </p>

      <div class="grid-2">
        {CONFLICTS_SUMMARY.map((c) => (
          <div class="editorial-card" style="padding: 1.25rem;">
            <div style="font-family: var(--font-mono); font-size: 0.74rem; color: var(--accent-molave); text-transform: uppercase;">
              Conflict ID {c.id}
            </div>
            <h3 style="font-size: 1.15rem; margin: 0.25rem 0 0.5rem 0;">{c.topic}</h3>
            <p style="margin: 0 0 0.35rem 0; font-size: 0.88rem;"><strong>Source A:</strong> {c.claimA}</p>
            <p style="margin: 0 0 0.5rem 0; font-size: 0.88rem;"><strong>Source B:</strong> {c.claimB}</p>
            <p style="margin: 0; font-size: 0.84rem; color: var(--ink-secondary); border-top: 1px solid var(--border-subtle); padding-top: 0.5rem;">
              <strong>Prototype Handling:</strong> {c.handling}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById('barangay-search');
      const rows = document.querySelectorAll('[data-barangay-row]');
      input?.addEventListener('input', (e) => {
        const q = (e.target.value || '').trim().toLowerCase();
        rows.forEach((row) => {
          const text = row.getAttribute('data-name') || '';
          if (!q || text.includes(q)) {
            row.removeAttribute('hidden');
          } else {
            row.setAttribute('hidden', '');
          }
        });
      });
    })();
  </script>
</BaseLayout>
