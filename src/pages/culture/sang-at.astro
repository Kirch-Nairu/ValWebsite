---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentStatus from '../../components/ContentStatus.astro';
import MediaPanel from '../../components/MediaPanel.astro';
import { STORIES } from '../../data/culture';

const story = STORIES[0];
---

<BaseLayout title="Sang-at Festival & Cultural Heritage | Municipality of Valencia, Bohol" description={story.summary}>
  <div class="container bread">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/tourism">Tourism & Culture</a>
    <span>/</span>
    <span>Sang-at Festival</span>
  </div>

  <section class="page-intro" style="position: relative; background: #0a1f1b url('/media/valencia/santo-nino-parish-arch.jpg') center center / cover no-repeat; overflow: hidden; padding: 48px 0;">
    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10, 31, 27, 0.92) 0%, rgba(15, 45, 38, 0.86) 50%, rgba(10, 31, 27, 0.94) 100%); pointer-events: none;" aria-hidden="true"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <p class="section-kicker" style="color: var(--valencia-orange); letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">{story.kicker}</p>
      <h1 style="color: #ffffff;">{story.title}</h1>
      <p class="page-intro-description" style="color: #d1e2db;">{story.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-layout">
      <article class="detail-main">
        <div style="margin-bottom: 24px;">
          <MediaPanel
            slotId="sang-at-street-dance"
            variant="main"
            label="Poblacion Civic & Parish Plaza"
            caption="Poblacion Occidental, Valencia, Bohol · Photo: pinay06 (CC BY 2.5)"
          />
        </div>

        {story.conflictDisclosure && (
          <ContentStatus label="Foundation Day Commemoration" detail={story.conflictDisclosure} />
        )}

        <h2>Cultural Origins & Community Celebration</h2>
        <p>{story.summary}</p>
        {story.body.map((p) => (
          <p>{p}</p>
        ))}

        <div class="button-row" style="margin-top: 28px;">
          <a href="/tourism" class="btn btn-primary">Explore Destinations</a>
          <a
            href="https://www.facebook.com/profile.php?id=61595179684543"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            SANG - AT Festival Facebook Page ↗
          </a>
        </div>
      </article>

      <aside class="detail-sidebar">
        <h2>Festival Profile</h2>
        <dl>
          <dt>Etymology</dt>
          <dd>Cebuano <em>sang-at</em> ("to lift onto an elevated place")</dd>
          <dt>Historical Setting</dt>
          <dd>Panangatan River & Poblacion, Valencia, Bohol</dd>
          <dt>Annual Schedule</dt>
          <dd>Late October (Foundation Day Anniversary)</dd>
          <dt>Provincial Showcase</dt>
          <dd>Tribung Hamiling Sang-at at Sandugo Street Dancing (July 2026)</dd>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>
