---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { SEARCH_INDEX } from '../data/search';

const pages = [
  { title: 'Municipal Services', url: '/services', summary: 'Locate municipal services and responsible offices', section: 'Services' },
  { title: 'Municipality & 35 Barangays', url: '/municipality', summary: 'Municipal profile, history, and searchable 35-barangay directory', section: 'Municipality' },
  { title: 'Government & Municipal Offices', url: '/government', summary: 'Office of the Mayor, Sangguniang Bayan, and department directory', section: 'Government' },
  { title: 'News & Announcements', url: '/news', summary: 'Dated community reports and municipal milestones', section: 'News' },
  { title: 'Projects & Progress', url: '/projects', summary: 'Infrastructure turnovers, digital initiatives, and barangay programs', section: 'Projects' },
  { title: 'Tourism & Culture', url: '/tourism', summary: 'Badiang Spring, 1882 Church Floor, waterfalls, peaks, caves, and Sang-at Festival', section: 'Tourism' },
  { title: 'Transparency & Public Records', url: '/transparency', summary: 'DILG Full Disclosure portal, PSA census, Bohol PPDO, and media credits', section: 'Transparency' },
  { title: 'Contact & Directions', url: '/contact', summary: 'Official communication channels and overland travel directions', section: 'Contact' }
];

const records = [
  ...pages.map((p, i) => ({ ...p, id: `new-${i}` })),
  ...SEARCH_INDEX.map((x) => ({
    id: x.id,
    title: x.title,
    summary: x.summary,
    section: x.section,
    url: x.url
  }))
];
---

<BaseLayout
  title="Search Directory | Municipality of Valencia, Bohol"
  description="Search municipal services, all 35 barangays, public announcements, development projects, and tourism destinations in Valencia, Bohol."
>
  <PageIntro
    eyebrow="Municipal Directory Search"
    title="Search Valencia Information"
    description="Find municipal services, all 35 barangays, public announcements, infrastructure projects, and natural or cultural landmarks across Valencia, Bohol."
    asideTitle="Quick Tip"
    aside="Search by barangay name (e.g., Anoyon, Anas, Limocon), service type (e.g., Civil Registry, Business Permit), or landmark."
    variant="forest"
    bgImage="/media/valencia/valencia-town-view.jpg"
  />

  <section class="section">
    <div class="container">
      <label for="page-search-input" class="section-kicker" style="display: block; color: var(--valencia-orange); letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 8px;">
        Search keyword
      </label>
      <input
        class="search-page-input"
        id="page-search-input"
        type="search"
        style="width: min(100%, 680px);"
        placeholder="e.g. Civil Registry, Badiang, Anoyon, Sang-at..."
        autocomplete="off"
      />
      <p class="tabs-note" id="page-search-count" aria-live="polite" style="margin: 13px 0 25px;">
        Browse popular sections or enter a search term above.
      </p>
      <div id="page-search-results" class="news-list" data-records={JSON.stringify(records)}></div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>('#page-search-input');
    const results = document.querySelector<HTMLElement>('#page-search-results');
    const count = document.querySelector<HTMLElement>('#page-search-count');
    if (input && results && count) {
      const entries = JSON.parse(results.dataset.records || '[]') as Array<{
        title: string;
        url: string;
        summary: string;
        section: string;
      }>;
      const params = new URLSearchParams(window.location.search);
      const initial = params.get('q');
      if (initial) input.value = initial;
      const render = () => {
        results.replaceChildren();
        const query = input.value.trim().toLocaleLowerCase();
        const shown = (
          query
            ? entries.filter((x) =>
                [x.title, x.summary, x.section].join(' ').toLocaleLowerCase().includes(query)
              )
            : entries.slice(0, 10)
        ).slice(0, 60);
        count.textContent = query
          ? `${shown.length} matching result${shown.length === 1 ? '' : 's'}`
          : 'Frequently accessed sections';
        if (!shown.length) {
          const empty = document.createElement('p');
          empty.textContent = 'No matching entries found. Try another keyword.';
          results.append(empty);
        }
        for (const item of shown) {
          const a = document.createElement('a');
          a.className = 'news-row search-result-row';
          a.href = item.url;
          const cat = document.createElement('span');
          cat.className = 'item-category';
          cat.textContent = item.section;
          const block = document.createElement('div');
          const title = document.createElement('h3');
          title.textContent = item.title;
          const description = document.createElement('p');
          description.textContent = item.summary;
          block.append(title, description);
          const arrow = document.createElement('span');
          arrow.className = 'news-read-label';
          arrow.textContent = 'Open';
          a.append(cat, block, arrow);
          results.append(a);
        }
      };
      input.addEventListener('input', render);
      render();
    }
  </script>
</BaseLayout>
