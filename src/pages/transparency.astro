---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ContentStatus from '../components/ContentStatus.astro';
import { OFFICIAL_CHANNELS, CONFLICTS_SUMMARY } from '../data/site';
const sources=OFFICIAL_CHANNELS.filter(x=>x.id==='PSA-PSGC'||x.id==='DILG-FDP'||x.id==='PPDO-BOHOL');
---
<BaseLayout title="Transparency & Public Documents" description="External authoritative disclosure, statistics and source references relevant to Valencia Bohol municipal information.">
<PageIntro eyebrow="07 / Accountability" title="Transparency & Documents" description="A navigable set of authoritative disclosure portals, statistical references and content-verification notes." aside="This independent prototype does not host or certify current municipal financial statements, procurement records, ordinances or Citizen's Charter PDFs."/>
<section class="section"><div class="container"><ContentStatus label="Primary disclosure sources — external gateways" detail="The links below open government or provincial sources. An external disclosure portal is not proof that a particular Valencia document is currently filed or available there."/>
<div class="section-heading" style="margin-top:38px;"><div><p class="eyebrow">Source gateways</p><h2>Go to the authoritative record.</h2></div></div>
<div class="source-grid">{sources.map(s=><a target="_blank" rel="noopener noreferrer" href={s.url}><span class="tag">{s.id}</span><strong>{s.name}</strong><small>{s.scope}</small><p class="text-link" style="margin:15px 0 0;display:inline-block;">Open source ↗</p></a>)}</div>
<div class="section-heading" style="margin-top:55px;"><div><p class="eyebrow">Publication validation</p><h2>What is not claimed here.</h2></div></div><div class="two-col"><div class="info-card"><h3>Documents and budgets</h3><p>Municipal budgets, procurement notices, ordinances, policy files and current Citizen’s Charter schedules must come from official municipal or government registers. None are fabricated or simulated as downloadable records.</p><a href="/contact">Verify through official channels ↗</a></div><div class="info-card"><h3>Content and media rights</h3><p>Destination photos, a municipal seal, leadership portraits and official media remain unapproved for reuse. The interface uses clearly identified non-photographic placeholders.</p><a href="/tourism">See documented locations ↗</a></div></div>
<div class="section-heading" style="margin-top:52px;"><div><p class="eyebrow">Research register</p><h2>Known source conflicts.</h2><p class="section-description">These discrepancies are disclosed rather than resolved by invented certainty.</p></div></div>
<div class="news-list">{CONFLICTS_SUMMARY.map(c=><div class="news-row conflict-row"><span class="item-category">{c.id}</span><div><h3>{c.topic}</h3><p>{c.claimA} / {c.claimB}</p><small>{c.handling}</small></div></div>)}</div>
</div></section>
</BaseLayout>
