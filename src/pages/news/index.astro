---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import NewsRow from '../../components/NewsRow.astro';
import { UPDATES } from '../../data/news';

const entries = [...UPDATES].sort((a, b) => b.publishedDate.localeCompare(a.publishedDate));
const categories = [...new Set(entries.map((u) => u.category))];
---

<BaseLayout
  title="News & Announcements | Municipality of Valencia, Bohol"
  description="Dated municipal reports, community announcements, and public milestones from Valencia, Bohol."
>
  <PageIntro
    eyebrow="Public Information"
    title="News & Announcements"
    description="Dated reports covering governance, classroom infrastructure, digital market initiatives, and cultural milestones in the Municipality of Valencia."
    asideTitle="Official LGU Page"
    aside="For daily municipal advisories and urgent community notices, follow the official LGU Valencia Facebook channel."
  />

  <section class="section">
    <div class="container">
      <div class="filter-toolbar">
        <label>
          Search headlines
          <input id="news-query" type="search" placeholder="e.g. Anoyon, Paleng-QR, Sang-at, DAP..." />
        </label>
        <label>
          Category
          <select id="news-category">
            <option value="all">All categories</option>
            {categories.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </label>
        <span class="filter-count" id="news-count">{entries.length} published reports</span>
      </div>

      <div class="news-list">
        {entries.map((u) => (
          <div
            data-news-item
            data-category={u.category}
            data-search={`${u.title} ${u.summary} ${u.publisher} ${u.category}`.toLocaleLowerCase()}
          >
            <NewsRow item={u} />
          </div>
        ))}
      </div>
      <p class="tabs-note" id="news-empty" hidden>No announcements match the selected filter.</p>
    </div>
  </section>

  <script>
    const q = document.querySelector<HTMLInputElement>('#news-query');
    const cat = document.querySelector<HTMLSelectElement>('#news-category');
    const count = document.querySelector<HTMLElement>('#news-count');
    const empty = document.querySelector<HTMLElement>('#news-empty');
    const rows = [...document.querySelectorAll<HTMLElement>('[data-news-item]')];
    function apply() {
      let shown = 0;
      for (const row of rows) {
        const yes =
          (!q?.value.trim() ||
            (row.dataset.search || '').includes(q.value.trim().toLocaleLowerCase())) &&
          (cat?.value === 'all' || cat?.value === row.dataset.category);
        row.hidden = !yes;
        if (yes) shown++;
      }
      if (count) count.textContent = `${shown} published report${shown === 1 ? '' : 's'}`;
      if (empty) empty.hidden = shown !== 0;
    }
    q?.addEventListener('input', apply);
    cat?.addEventListener('change', apply);
  </script>
</BaseLayout>
