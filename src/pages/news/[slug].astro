---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentStatus from '../../components/ContentStatus.astro';
import { UPDATES } from '../../data/news';
import type { UpdateItem } from '../../data/types';

export function getStaticPaths() {
  return UPDATES.map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

interface Props {
  item: UpdateItem;
}

const { item } = Astro.props;
---

<BaseLayout title={item.title} description={item.summary}>
  <div class="container bread">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/news">News & Announcements</a>
    <span>/</span>
    <span>{item.category}</span>
  </div>

  <section class="page-intro" style="position: relative; background: #0a1f1b url('/media/valencia/valencia-business-center-day.jpg') center center / cover no-repeat; overflow: hidden; padding: 48px 0;">
    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10, 31, 27, 0.92) 0%, rgba(15, 45, 38, 0.86) 50%, rgba(10, 31, 27, 0.94) 100%); pointer-events: none;" aria-hidden="true"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <p class="section-kicker" style="color: var(--valencia-orange); letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">{item.category} · {item.publishedDate}</p>
      <h1 style="color: #ffffff;">{item.title}</h1>
      <p class="page-intro-description" style="color: #d1e2db;">{item.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-layout">
      <article class="detail-main">
        <ContentStatus label="Context Note" detail={item.cautionNote} />
        <h2>Summary</h2>
        <p>{item.summary}</p>

        <h2>Key Highlights</h2>
        <ul>
          {item.keyFacts.map((f) => (
            <li>{f}</li>
          ))}
        </ul>

        <div class="button-row" style="margin-top: 28px;">
          <a href="/news" class="btn btn-primary">All News & Announcements</a>
          {item.sourceUrl && (
            <a
              href={item.sourceUrl}
              class="btn btn-outline"
              target="_blank"
              rel="noopener noreferrer"
            >
              Read Original Publication ↗
            </a>
          )}
        </div>
      </article>

      <aside class="detail-sidebar">
        <h2>Publication Details</h2>
        <dl>
          <dt>Publisher</dt>
          <dd>{item.publisher}</dd>
          <dt>Date Published</dt>
          <dd>
            <time datetime={item.publishedDate}>{item.publishedDate}</time>
          </dd>
          <dt>Event Period</dt>
          <dd>{item.eventDate}</dd>
          <dt>Category</dt>
          <dd>{item.category}</dd>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>
