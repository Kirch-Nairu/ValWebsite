---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentStatus from '../../components/ContentStatus.astro';
import { SERVICE_CATEGORIES } from '../../data/services';
import type { ServiceCategoryItem } from '../../data/types';

export function getStaticPaths() {
  return SERVICE_CATEGORIES.map((item) => ({
    params: { id: item.id },
    props: { item }
  }));
}

interface Props {
  item: ServiceCategoryItem;
}

const { item } = Astro.props;
---

<BaseLayout title={item.title} description={item.summary}>
  <div class="container bread">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/services">Municipal Services</a>
    <span>/</span>
    <span>{item.title}</span>
  </div>

  <section class="page-intro">
    <div class="container">
      <p class="section-kicker">{item.office}</p>
      <h1>{item.title}</h1>
      <p class="page-intro-description">{item.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-layout">
      <article class="detail-main">
        <ContentStatus label="In-Person Municipal Service" detail={item.officialChannelNote} />
        <h2>Service Overview</h2>
        <p>{item.summary}</p>

        <h2>Preparation & Guidance</h2>
        <ul>
          {item.publicGuidance.map((g) => (
            <li>{g}</li>
          ))}
        </ul>

        <div class="button-row" style="margin-top: 30px;">
          <a href="/contact" class="btn btn-primary">Contact & Office Location</a>
          <a href="/services" class="btn btn-outline">All Municipal Services</a>
        </div>
      </article>

      <aside class="detail-sidebar">
        <h2>Office Reference</h2>
        <dl>
          <dt>Responsible Office</dt>
          <dd>{item.office}</dd>
          <dt>Transaction Mode</dt>
          <dd>{item.charterStatus}</dd>
          <dt>Location</dt>
          <dd>Valencia Municipal Hall, Poblacion, Valencia, Bohol</dd>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>
