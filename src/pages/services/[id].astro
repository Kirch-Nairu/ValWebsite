---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentStatus from '../../components/ContentStatus.astro';
import { SERVICE_CATEGORIES } from '../../data/services';
import type { ServiceCategoryItem } from '../../data/types';
export function getStaticPaths(){return SERVICE_CATEGORIES.map(item=>({params:{id:item.id},props:{item}}));}
interface Props{item:ServiceCategoryItem}
const {item}=Astro.props;
---
<BaseLayout title={item.title} description={item.summary}>
<div class="container bread"><a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span><span>{item.title}</span></div>
<section class="page-intro"><div class="container"><p class="eyebrow">Municipal service guide</p><h1>{item.title}</h1><p class="page-intro-description">{item.summary}</p></div></section>
<section class="section"><div class="container detail-layout"><article class="detail-main"><ContentStatus label="Current Citizen’s Charter pending" detail={item.charterStatus+'. This is an informational guide only. It does not confirm a fee, processing period, eligibility or required document checklist.'}/><h2>Service orientation</h2><p>{item.summary}</p><h2>What to verify with the office</h2><ul>{item.publicGuidance.map(g=><li>{g}</li>)}</ul><p>{item.officialChannelNote}</p><div class="button-row" style="margin-top:30px;"><a href="/contact" class="btn btn-primary">Check official channels ↗</a><a href="/services" class="btn btn-outline">All services</a></div></article><aside class="detail-sidebar"><h2>Service reference</h2><dl><dt>Responsible office</dt><dd>{item.office}</dd><dt>Current charter status</dt><dd>{item.charterStatus}</dd><dt>Application availability</dt><dd>No online submission in this prototype</dd></dl></aside></div></section>
</BaseLayout>
