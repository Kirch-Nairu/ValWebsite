---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import MediaPanel from '../../components/MediaPanel.astro';
import { SERVICE_CATEGORIES } from '../../data/services';
---

<BaseLayout
  title="Municipal Services | Municipality of Valencia, Bohol"
  description="Guide to frontline municipal services in Valencia, Bohol: civil registry, business permits, real property tax, social welfare, rural health, agriculture, and eco-tourism."
>
  <PageIntro
    eyebrow="Resident & Business Services"
    title="Municipal Services"
    description="Locate the responsible department at Valencia Municipal Hall and review documentary preparation before visiting in person."
    asideTitle="In-Person Transactions"
    aside="All official applications, assessments, and payments are processed directly at Valencia Municipal Hall windows in Poblacion."
  />

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Service Directory</p>
          <h2>Frontline Service Categories</h2>
          <p class="section-description">
            Select a category to view the responsible municipal office and preparation notes.
          </p>
        </div>
      </div>

      <div class="service-grid two">
        {SERVICE_CATEGORIES.map((s) => (
          <ServiceCard item={s} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section-stone">
    <div class="container">
      <div class="municipality-story-grid">
        <div>
          <p class="section-kicker">Before Visiting Municipal Hall</p>
          <h2>Preparing for Your Transaction</h2>
          <div class="two-col" style="margin-top: 20px;">
            <div class="info-card">
              <h3>Bring Valid Identification</h3>
              <p>
                Present a valid government-issued ID along with any required barangay certification, cedula, or supporting civil/property records when transacting with municipal windows.
              </p>
              <a href="/government">View municipal offices →</a>
            </div>
            <div class="info-card">
              <h3>Official Treasury Windows Only</h3>
              <p>
                Pay Real Property Tax, business permit fees, and civil registry charges exclusively at the Office of the Municipal Treasurer at Valencia Municipal Hall and secure an Official Receipt.
              </p>
              <a href="/contact">Official LGU channels →</a>
            </div>
          </div>
        </div>

        <div>
          <MediaPanel
            slotId="sunday-tabu-market"
            variant="main"
            label="Valencia Public Market & Town Center"
            caption="Poblacion, Valencia, Bohol · Photo: P199 (CC BY-SA 3.0)"
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
