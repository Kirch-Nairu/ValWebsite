---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentStatus from '../../components/ContentStatus.astro';
import MediaPanel from '../../components/MediaPanel.astro';
import { PROGRESS_ITEMS } from '../../data/projects';
import type { ProgressItem } from '../../data/types';

export function getStaticPaths() {
  return PROGRESS_ITEMS.map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

interface Props {
  item: ProgressItem;
}

const { item } = Astro.props;
---

<BaseLayout title={item.title} description={item.summary}>
  <div class="container bread">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/projects">Projects & Progress</a>
    <span>/</span>
    <span>{item.title}</span>
  </div>

  <section class="page-intro" style="position: relative; background: #0a1f1b url('/media/valencia/valencia-town-view.jpg') center center / cover no-repeat; overflow: hidden; padding: 48px 0;">
    <div style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10, 31, 27, 0.92) 0%, rgba(15, 45, 38, 0.86) 50%, rgba(10, 31, 27, 0.94) 100%); pointer-events: none;" aria-hidden="true"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <p class="section-kicker" style="color: var(--valencia-orange); letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">{item.statusBadge} · {item.dateLabel}</p>
      <h1 style="color: #ffffff;">{item.title}</h1>
      <p class="page-intro-description" style="color: #d1e2db;">{item.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-layout">
      <article class="detail-main">
        <div style="margin-bottom: 24px;">
          <MediaPanel
            slotId={item.mediaSlotId}
            variant="main"
            label={item.title}
            caption={item.barangay}
          />
        </div>

        <ContentStatus label="Program Status" detail={item.verificationNote} />

        <h2>Overview & Implementation</h2>
        <p>{item.summary}</p>
        {item.details.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        {item.slug === 'paleng-qr-ph-plus-launch' && (
          <div style="margin-top: 24px; margin-bottom: 24px;">
            <figure style="margin: 0; background: var(--stone); border: 1px solid var(--line); border-radius: 8px; overflow: hidden;">
              <img
                src="/media/valencia/valencia-business-center-night.jpg"
                alt="Valencia Business Center illuminated night facade"
                style="width: 100%; height: 260px; object-fit: cover; display: block;"
                loading="lazy"
              />
              <figcaption style="padding: 10px 14px; font-size: 0.82rem; color: var(--muted); border-top: 1px solid var(--line);">
                <strong style="color: var(--ink);">Night View: Valencia Business Center</strong> — Evening facade illumination along the municipal commercial center in Poblacion.
              </figcaption>
            </figure>
          </div>
        )}

        <div class="button-row" style="margin-top: 28px;">
          <a href="/projects" class="btn btn-primary">Back to Projects Register</a>
          {item.sourceUrl && (
            <a
              href={item.sourceUrl}
              class="btn btn-outline"
              rel="noopener noreferrer"
              target="_blank"
            >
              View Publication ↗
            </a>
          )}
        </div>
      </article>

      <aside class="detail-sidebar">
        <h2>Project Profile</h2>
        <dl>
          <dt>Status</dt>
          <dd>{item.statusBadge}</dd>
          <dt>Location</dt>
          <dd>{item.barangay}</dd>
          <dt>Date</dt>
          <dd>{item.dateLabel}</dd>
          <dt>Implementing Office</dt>
          <dd>{item.implementingBody}</dd>
          <dt>Partner / Agency</dt>
          <dd>{item.partnerOrDonor}</dd>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>
