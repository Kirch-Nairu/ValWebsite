---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import MediaPanel from '../components/MediaPanel.astro';
import { SITE_META } from '../data/site';
import { BARANGAYS } from '../data/municipality';
---

<BaseLayout
  title="Municipality & 35 Barangays | Municipality of Valencia, Bohol"
  description="Municipal profile, Panangatan settlement history, geographical boundaries, and searchable directory of all 35 barangays in Valencia, Bohol (PSGC 0701247000)."
>
  <PageIntro
    eyebrow="Municipal Profile · PSGC 0701247000"
    title="Municipality & 35 Barangays"
    description="Situated along the southern coast of Bohol 42 kilometers east of Tagbilaran City, Valencia connects coastal fishing and resort villages with 25 interior agricultural barangays."
    asideTitle="BARUG VALENCIA"
    aside="Valencia’s municipal identity honors its heritage as Panangatan—where communities lifted their boats together—while advancing responsive public service across all 35 barangays."
  />

  <section class="section">
    <div class="container">
      <div class="count-grid">
        <div class="count-card">
          <strong>{SITE_META.population2024}</strong>
          <span>2024 Census Population (PSA)</span>
        </div>
        <div class="count-card">
          <strong>{SITE_META.barangayCount}</strong>
          <span>10 Coastal & Poblacion · 25 Upland & Interior</span>
        </div>
        <div class="count-card">
          <strong>{SITE_META.psgcCode}</strong>
          <span>Philippine Standard Geographic Code</span>
        </div>
      </div>

      <div class="municipality-story-grid" style="margin-top: 42px;">
        <div>
          <p class="section-kicker">History & Geography</p>
          <h2>From Barrio Panangatan to Modern Valencia</h2>
          <p class="section-lead">
            Before its establishment as an independent town in the late 1860s, the settlement was known as <strong>Panangatan</strong>—a barrio of neighboring Dimiao named after the Cebuano word <em>sang-at</em> ("to place on an elevated spot"). During the southwest monsoon (<em>habagat</em>), fishermen navigated into the mouth of the Panangatan River and lifted their wooden outrigger boats onto the elevated, nipa-lined riverbanks for shelter.
          </p>
          <p class="section-lead">
            Separated from Dimiao in 1867 (and formally instituted on October 27, 1869 in provincial and parish chronicles), the municipality was named <strong>Valencia</strong> by its Spanish Recollect parish priest. By 1871, it became an independent parish dedicated to Sr. Santo Niño. Today, Valencia spans a coastal plain on the Bohol Sea and limestone interior ridges rising to 485 meters above sea level.
          </p>
          <div class="button-row" style="margin-top: 24px;">
            <a href="/stories/panangatan-origin" class="btn btn-primary">Read Panangatan History</a>
            <a href="/culture/sang-at" class="btn btn-outline">Sang-at Festival Profile</a>
          </div>
        </div>

        <div class="municipality-photo-stack">
          <MediaPanel
            slotId="hero-panangatan"
            variant="main"
            label="Welcome to Valencia Highway Arch"
            caption="Southern Coastal Highway, Valencia, Bohol · Photo: P199 (Public Domain)"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section section-stone" id="barangays">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Geographic Registry</p>
          <h2>Directory of All 35 Barangays</h2>
          <p class="section-description">
            Search by barangay name, PSGC code, or local landmark, or filter between coastal/Poblacion and upland/interior zones.
          </p>
        </div>
        <a
          class="text-link"
          href="https://psa.gov.ph/classification/psgc/barangays/0701247000"
          target="_blank"
          rel="noopener noreferrer"
        >
          PSA PSGC Registry (0701247000) ↗
        </a>
      </div>

      <div class="filter-toolbar">
        <label>
          Search barangays
          <input id="barangay-search" type="search" placeholder="e.g. Anas, Poblacion, Anoyon, Banderahan..." />
        </label>
        <label>
          Geographic zone
          <select id="barangay-zone">
            <option value="all">All areas (35 barangays)</option>
            <option value="Poblacion & Coastal">Poblacion & Coastal (10)</option>
            <option value="Upland & Interior">Upland & Interior (25)</option>
          </select>
        </label>
        <span id="barangay-count" class="filter-count">{BARANGAYS.length} directory entries</span>
      </div>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Barangay Name</th>
              <th>Geographic Zone</th>
              <th>PSGC Code</th>
              <th>Notable Landmarks & Community Profile</th>
            </tr>
          </thead>
          <tbody>
            {BARANGAYS.map((b) => (
              <tr
                data-barangay-row
                data-name={`${b.name} ${b.psgc} ${b.notableFeatures}`.toLocaleLowerCase()}
                data-zone={b.zone}
              >
                <td><strong>{b.name}</strong></td>
                <td><span class="tag">{b.zone}</span></td>
                <td><code>{b.psgc}</code></td>
                <td>{b.notableFeatures}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script>
    const input = document.querySelector<HTMLInputElement>('#barangay-search');
    const select = document.querySelector<HTMLSelectElement>('#barangay-zone');
    const count = document.querySelector<HTMLElement>('#barangay-count');
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('[data-barangay-row]')];
    function run() {
      const q = (input?.value || '').trim().toLocaleLowerCase();
      const zone = select?.value;
      let shown = 0;
      for (const row of rows) {
        const valid =
          (!q || (row.dataset.name || '').includes(q)) &&
          (zone === 'all' || zone === row.dataset.zone);
        row.hidden = !valid;
        if (valid) shown++;
      }
      if (count) count.textContent = `${shown} directory entr${shown === 1 ? 'y' : 'ies'}`;
    }
    input?.addEventListener('input', run);
    select?.addEventListener('change', run);
  </script>
</BaseLayout>
