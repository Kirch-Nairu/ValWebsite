---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ValenciaMediaSlot from '../../components/ValenciaMediaSlot.astro';
import { DESTINATIONS, type DestinationItem } from '../../data/valenciaData';

export function getStaticPaths() {
  return DESTINATIONS.filter((d) => d.hasDedicatedDetail).map((dest) => ({
    params: { slug: dest.slug },
    props: { dest }
  }));
}

interface Props {
  dest: DestinationItem;
}

const { dest } = Astro.props;
const related = DESTINATIONS.filter((d) => d.slug !== dest.slug && d.hasDedicatedDetail).slice(0, 3);
---

<BaseLayout title={`${dest.name} (${dest.barangay}) — Discover Valencia`} description={dest.summary}>
  <article class="section-block">
    <div class="container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Home</a></li>
          <li><a href="/discover">Discover Valencia</a></li>
          <li aria-current="page">{dest.name}</li>
        </ol>
      </nav>

      <div style="display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: center; margin-bottom: 0.85rem;">
        <span
          class:list={[
            'badge',
            dest.readiness === 'established'
              ? 'badge-established'
              : dest.readiness === 'potential'
                ? 'badge-potential'
                : 'badge-pending'
          ]}
        >
          {dest.readinessLabel}
        </span>
        <span style="font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink-muted);">
          {dest.barangay}, Valencia, Bohol · {dest.category}
        </span>
      </div>

      <h1 class="display-hero" style="font-size: clamp(2rem, 4vw, 3.25rem);">{dest.name}</h1>

      {dest.alternateName && (
        <p style="font-size: 0.9rem; color: var(--ink-muted); font-style: italic; margin-top: -0.5rem;">
          {dest.alternateName}
        </p>
      )}

      <p class="lead-paragraph">{dest.summary}</p>

      <div style="margin-block: 2rem;">
        <ValenciaMediaSlot slotId={dest.mediaSlotId} />
      </div>

      <div class="grid-2" style="align-items: start;">
        <div style="display: flex; flex-direction: column; gap: 1.15rem; font-size: 1.04rem;">
          <h2 class="section-title" style="font-size: 1.65rem; margin-bottom: 0.25rem;">
            Documented Place Profile
          </h2>
          {dest.editorialBody.map((para) => (
            <p style="margin: 0; color: var(--ink-primary);">{para}</p>
          ))}
        </div>

        <aside style="display: flex; flex-direction: column; gap: 1.15rem;">
          <div class="editorial-card" style="padding: 1.35rem;">
            <h3 style="font-size: 1.15rem; margin-bottom: 0.65rem;">Source &amp; Verification Record</h3>
            <dl style="margin: 0; display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.88rem;">
              <div>
                <dt style="font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--ink-muted);">
                  Barangay Location
                </dt>
                <dd style="margin: 0.15rem 0 0 0; font-weight: 700;">{dest.barangay}, Municipality of Valencia, Bohol</dd>
              </div>
              <div>
                <dt style="font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--ink-muted);">
                  Primary Citation
                </dt>
                <dd style="margin: 0.15rem 0 0 0;">{dest.ppdoPage} (Refs: {dest.sourceIds.join(', ')})</dd>
              </div>
              <div>
                <dt style="font-family: var(--font-mono); font-size: 0.72rem; text-transform: uppercase; color: var(--ink-muted);">
                  Visitor &amp; Access Notice
                </dt>
                <dd style="margin: 0.15rem 0 0 0; color: var(--ink-secondary);">{dest.visitorNotice}</dd>
              </div>
            </dl>

            <div style="margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--border-subtle); display: flex; flex-wrap: wrap; gap: 0.6rem;">
              <button type="button" class="btn btn-outline-dark" id="copy-page-link-btn" style="padding: 0.45rem 0.9rem; font-size: 0.82rem;">
                Copy Guide Link
              </button>
              <a href="/contact" class="btn btn-dark" style="padding: 0.45rem 0.9rem; font-size: 0.82rem;">
                Inquire via Official Channels
              </a>
            </div>
            <p id="copy-link-feedback" style="margin: 0.5rem 0 0 0; font-size: 0.78rem; color: var(--accent-spring);" hidden>
              Link copied to clipboard.
            </p>
          </div>

          {dest.sensitivityNote && (
            <div class="callout-box" style="background: rgba(143, 45, 36, 0.1); border-left-color: var(--accent-crimson);">
              <strong>Cultural &amp; Environmental Sensitivity:</strong> {dest.sensitivityNote}
            </div>
          )}
        </aside>
      </div>
    </div>
  </article>

  <section class="section-block section-sand">
    <div class="container">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
        <h2 class="section-title" style="font-size: 1.65rem; margin: 0;">Explore More Documented Valencia Places</h2>
        <a href="/discover" class="btn btn-outline-dark">← Back to All 14 PPDO Sites</a>
      </div>
      <div class="grid-3">
        {related.map((item) => (
          <article class="editorial-card">
            <ValenciaMediaSlot slotId={item.mediaSlotId} compact={true} showMetadata={false} />
            <div class="editorial-card-body">
              <span class="badge badge-potential">{item.barangay}</span>
              <h3 style="font-size: 1.2rem; margin: 0.2rem 0;">
                <a href={`/discover/${item.slug}`} style="text-decoration: none;">{item.name}</a>
              </h3>
              <p style="margin: 0; font-size: 0.88rem; color: var(--ink-secondary);">{item.summary}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const btn = document.getElementById('copy-page-link-btn');
      const feedback = document.getElementById('copy-link-feedback');
      btn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          if (feedback) {
            feedback.removeAttribute('hidden');
            setTimeout(() => feedback.setAttribute('hidden', ''), 3000);
          }
        } catch {
          // Fallback if clipboard API is restricted
        }
      });
    })();
  </script>
</BaseLayout>
