---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ValenciaMediaSlot from '../../components/ValenciaMediaSlot.astro';
import { DESTINATIONS } from '../../data/valenciaData';

const categories = ['All', 'Established Only', 'Potential Sites', 'Spring & Coast', 'Heritage & Architecture', 'Highlands & Peaks', 'Falls & Lakes', 'Karst Caves'];
---

<BaseLayout
  title="Discover Valencia — Springs, Heritage & 14 PPDO Ecotourism Sites"
  description="Curated visitor and place directory for Valencia, Bohol based on the Bohol PPDO CY2025 Tourism Profile (printed pages 192–195), separating established landmarks from potential ecotourism sites."
>
  <section class="section-block section-deep">
    <div class="container">
      <span class="eyebrow eyebrow-light">Discover Valencia, Bohol · PPDO CY2025 Inventory</span>
      <h1 class="display-hero" style="font-size: clamp(2rem, 4.2vw, 3.4rem);">
        From Coastal Cold Springs to Interior Limestone Ridges
      </h1>
      <p class="lead-paragraph">
        Every site below is documented in the official <strong>Bohol PPDO CY2025 Tourism Profile (printed pages 192–195 / PDF pages 196–199)</strong>. To protect visitors and uphold editorial honesty, we clearly distinguish <strong>established landmarks</strong> from the <strong>fourteen (14) potential ecotourism sites</strong> identified in the municipality’s tourism roadmap—and we never invent operating hours, entrance fees, or trail safety claims.
      </p>
    </div>
  </section>

  <section class="section-block">
    <div class="container">
      <div class="callout-box" style="margin-bottom: 1.75rem;">
        <strong>Visitor &amp; Source Governance (`S001` / `S024`):</strong> Established sites such as <em>Badiang Spring Resort and Hotel</em> (Brgy. Anas) and <em>Sr. Santo Niño Parish Church</em> (Poblacion Occidental) are publicly recognizable landmarks, though current 2026 fee tables and schedules must be confirmed on-site. Sites marked <strong>Potential Ecotourism Site</strong> or <strong>Prospective Cave Site</strong> require municipal tourism guidance and environmental clearance before entry.
      </div>

      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem;">
        <h2 class="section-title" style="font-size: 1.6rem; margin: 0;">Filter Attractions &amp; Prospective Sites</h2>
        <span id="discover-count-label" style="font-family: var(--font-mono); font-size: 0.84rem; color: var(--ink-muted);">
          Showing all {DESTINATIONS.length} documented entries (covering all 14 PPDO records)
        </span>
      </div>

      <div class="filter-bar" role="toolbar" aria-label="Filter Valencia destinations by readiness or category">
        {categories.map((cat, idx) => (
          <button
            type="button"
            class="filter-btn"
            data-discover-filter={cat}
            aria-pressed={idx === 0 ? 'true' : 'false'}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="grid-2" id="discover-grid">
        {DESTINATIONS.map((dest) => (
          <article
            class="editorial-card"
            id={dest.slug}
            data-discover-card
            data-category={dest.category}
            data-readiness={dest.readiness}
          >
            <ValenciaMediaSlot slotId={dest.mediaSlotId} compact={true} />
            <div class="editorial-card-body">
              <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; align-items: center;">
                <span
                  class:list={[
                    'badge',
                    dest.readiness === 'established'
                      ? 'badge-established'
                      : dest.readiness === 'potential'
                        ? 'badge-potential'
                        : 'badge-pending'
                  ]}
                >
                  {dest.readinessLabel}
                </span>
                <span style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--ink-muted);">
                  {dest.barangay} · {dest.category}
                </span>
              </div>

              <h3 style="font-size: 1.4rem; margin: 0.2rem 0;">
                {dest.hasDedicatedDetail ? (
                  <a href={`/discover/${dest.slug}`} style="text-decoration: none;">{dest.name}</a>
                ) : (
                  dest.name
                )}
              </h3>

              {dest.alternateName && (
                <div style="font-size: 0.78rem; color: var(--ink-muted); font-style: italic;">
                  {dest.alternateName}
                </div>
              )}

              <p style="margin: 0; color: var(--ink-secondary); font-size: 0.94rem;">{dest.summary}</p>

              <div class="callout-box" style="margin-top: 0.5rem; padding: 0.65rem 0.9rem; font-size: 0.82rem;">
                <strong>Access &amp; Safety Status:</strong> {dest.visitorNotice}
              </div>

              {dest.sensitivityNote && (
                <div class="callout-box" style="background: rgba(143, 45, 36, 0.1); border-left-color: var(--accent-crimson); padding: 0.65rem 0.9rem; font-size: 0.82rem;">
                  <strong>Cultural / Archaeological Safeguard:</strong> {dest.sensitivityNote}
                </div>
              )}

              <div style="margin-top: auto; padding-top: 0.85rem; border-top: 1px solid var(--border-subtle); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem; font-size: 0.8rem;">
                <span style="font-family: var(--font-mono); color: var(--ink-muted);">
                  Source: {dest.ppdoPage} ({dest.sourceIds.join(', ')})
                </span>
                {dest.hasDedicatedDetail && (
                  <a href={`/discover/${dest.slug}`} class="btn btn-outline-dark" style="padding: 0.4rem 0.85rem; font-size: 0.82rem;">
                    Full Site Guide →
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Complete 14-Entry PPDO CY2025 Reference Ledger Table -->
  <section class="section-block section-sand">
    <div class="container">
      <span class="eyebrow">Complete Provincial Inventory Cross-Reference</span>
      <h2 class="section-title" style="font-size: 1.75rem;">All 14 Bohol PPDO CY2025 Valencia Entries at a Glance</h2>
      <p style="color: var(--ink-secondary); margin-bottom: 1.25rem;">
        Exact cross-reference to printed pages 192–195 of the Bohol PPDO CY2025 Tourism Profile (`S001` / `S024`).
      </p>

      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>
              <th>#</th>
              <th>PPDO Attraction Name</th>
              <th>Barangay</th>
              <th>PPDO Category</th>
              <th>Readiness Classification</th>
              <th>Guide Link</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1</td>
              <td><strong>Anislag Spring</strong></td>
              <td>Omjon</td>
              <td>Nature / Cold Spring</td>
              <td>Potential (1 of 14 sites; community-maintained since 2014)</td>
              <td><a href="#anislag-spring">View Card</a></td>
            </tr>
            <tr>
              <td>2</td>
              <td><strong>Badiang Spring Resort and Hotel</strong></td>
              <td>Anas</td>
              <td>Nature / Pool and Spring</td>
              <td>Established Coastal Spring Resort (confirm current hours/fees)</td>
              <td><a href="/discover/badiang-spring">Full Guide →</a></td>
            </tr>
            <tr>
              <td>3</td>
              <td><strong>Banderahan Peak</strong></td>
              <td>Banderahan</td>
              <td>Mountains, Hills, Highlands</td>
              <td>Potential (1 of 14 sites; historic WWII lookout)</td>
              <td><a href="/discover/banderahan-ugjong-highlands">Full Guide →</a></td>
            </tr>
            <tr>
              <td>4</td>
              <td><strong>Cabjawan Cave</strong></td>
              <td>Nailo</td>
              <td>Cave (Inland)</td>
              <td>Prospective (1 of 14 sites; narrow entrance, bats)</td>
              <td><a href="/discover/valencia-karst-caves">Full Guide →</a></td>
            </tr>
            <tr>
              <td>5</td>
              <td><strong>Danao Lake</strong></td>
              <td>Danao</td>
              <td>Lakes and Ponds</td>
              <td>Community tilapia aquaculture basin</td>
              <td><a href="#danao-lake">View Card</a></td>
            </tr>
            <tr>
              <td>6</td>
              <td><strong>Dr. Canuto Lim Ancestral House</strong></td>
              <td>Poblacion Occidental</td>
              <td>History &amp; Culture / Structures</td>
              <td>Private family heritage building (preserved wooden floors)</td>
              <td><a href="/discover/lim-ancestral-house">Full Guide →</a></td>
            </tr>
            <tr>
              <td>7</td>
              <td><strong>Kabotbot Hills</strong></td>
              <td>Limocon</td>
              <td>Mountains, Hills, Highlands</td>
              <td>Potential (1 of 14 sites; motor-trail hills)</td>
              <td><a href="/discover/banderahan-ugjong-highlands">Full Guide →</a></td>
            </tr>
            <tr>
              <td>8</td>
              <td><strong>Kinawa Falls</strong></td>
              <td>Tausi-on</td>
              <td>Nature / Falls</td>
              <td>Potential (named in 2023 SOMA; cauldron rock basin)</td>
              <td><a href="/discover/kinawa-falls">Full Guide →</a></td>
            </tr>
            <tr>
              <td>9</td>
              <td><strong>Maubo Cave</strong></td>
              <td>Maubo</td>
              <td>Cave (Inland)</td>
              <td>Potential / Sensitive (balinsasayaw birds; Lenten healing rituals)</td>
              <td><a href="/discover/valencia-karst-caves">Full Guide →</a></td>
            </tr>
            <tr>
              <td>10</td>
              <td><strong>Sang-at Festival</strong></td>
              <td>Valencia (Municipal)</td>
              <td>Customs &amp; Tradition / Festivals</td>
              <td>Annual October 27 Foundation Day Cultural Festival</td>
              <td><a href="/culture/sang-at">Festival Feature →</a></td>
            </tr>
            <tr>
              <td>11</td>
              <td><strong>Sr. Santo Niño Parish Church</strong></td>
              <td>Poblacion Occidental</td>
              <td>History &amp; Culture / Religious Site</td>
              <td>Established 1871/1882 Heritage Landmark (NMP ICP Marker)</td>
              <td><a href="/discover/sto-nino-parish-church">Full Guide →</a></td>
            </tr>
            <tr>
              <td>12</td>
              <td><strong>Taculing Cave</strong></td>
              <td>Banderahan</td>
              <td>Cave (Inland)</td>
              <td>Potential / Sensitive (WWII Japanese hideout; bone traces)</td>
              <td><a href="/discover/valencia-karst-caves">Full Guide →</a></td>
            </tr>
            <tr>
              <td>13</td>
              <td><strong>Ughob Cave</strong></td>
              <td>Botong</td>
              <td>Cave (Inland)</td>
              <td>Potential (1 of 14 sites; stalactites at cave mouth)</td>
              <td><a href="/discover/valencia-karst-caves">Full Guide →</a></td>
            </tr>
            <tr>
              <td>14</td>
              <td><strong>Ugjong Peak</strong></td>
              <td>Limocon</td>
              <td>Mountains, Hills, Highlands</td>
              <td>Scenic ridge for campers, hikers &amp; bikers</td>
              <td><a href="/discover/banderahan-ugjong-highlands">Full Guide →</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const buttons = document.querySelectorAll('[data-discover-filter]');
      const cards = document.querySelectorAll('[data-discover-card]');
      const countLabel = document.getElementById('discover-count-label');

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-discover-filter') || 'All';
          buttons.forEach((b) => b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'));

          let visibleCount = 0;
          cards.forEach((card) => {
            const cat = card.getAttribute('data-category');
            const readiness = card.getAttribute('data-readiness');
            let match = false;
            if (filter === 'All') match = true;
            else if (filter === 'Established Only') match = readiness === 'established';
            else if (filter === 'Potential Sites') match = readiness === 'potential' || readiness === 'status_pending_verification';
            else match = cat === filter;

            if (match) {
              card.removeAttribute('hidden');
              visibleCount++;
            } else {
              card.setAttribute('hidden', '');
            }
          });

          if (countLabel) {
            countLabel.textContent = `Showing ${visibleCount} documented ${visibleCount === 1 ? 'entry' : 'entries'} for "${filter}"`;
          }
        });
      });
    })();
  </script>
</BaseLayout>
