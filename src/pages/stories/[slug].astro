---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentStatus from '../../components/ContentStatus.astro';
import MediaPanel from '../../components/MediaPanel.astro';
import { STORIES } from '../../data/culture';
import type { StoryItem } from '../../data/types';

export function getStaticPaths() {
  return STORIES.filter((s) => s.route.startsWith('/stories/')).map((item) => ({
    params: { slug: item.slug },
    props: { item }
  }));
}

interface Props {
  item: StoryItem;
}

const { item } = Astro.props;
---

<BaseLayout title={item.title} description={item.summary}>
  <div class="container bread">
    <a href="/">Home</a>
    <span>/</span>
    <a href="/tourism">Tourism & Culture</a>
    <span>/</span>
    <span>{item.kicker}</span>
  </div>

  <section class="page-intro">
    <div class="container">
      <p class="section-kicker">{item.kicker}</p>
      <h1>{item.title}</h1>
      <p class="page-intro-description">{item.subtitle}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-layout">
      <article class="detail-main">
        <div style="margin-bottom: 24px;">
          <MediaPanel
            slotId={item.mediaSlotId}
            variant="main"
            label={item.title}
            caption={item.barangayOrPlace}
          />
        </div>

        {item.conflictDisclosure && (
          <ContentStatus label="Historical Note" detail={item.conflictDisclosure} />
        )}

        <h2>Feature Narrative</h2>
        {item.body.map((p) => (
          <p>{p}</p>
        ))}

        <div class="button-row" style="margin-top: 26px;">
          <a href="/tourism" class="btn btn-primary">Tourism & Culture Guide</a>
          <a href="/municipality" class="btn btn-outline">Municipality & 35 Barangays</a>
        </div>
      </article>

      <aside class="detail-sidebar">
        <h2>Feature Reference</h2>
        <dl>
          <dt>Location</dt>
          <dd>{item.barangayOrPlace}</dd>
          <dt>Historical Period</dt>
          <dd>{item.eventOrRecordDate}</dd>
          <dt>Primary References</dt>
          <dd>{item.sourceIds.join(' · ')}</dd>
        </dl>
      </aside>
    </div>
  </section>
</BaseLayout>
