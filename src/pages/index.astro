---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import NewsRow from '../components/NewsRow.astro';
import MediaPanel from '../components/MediaPanel.astro';
import { SERVICE_CATEGORIES } from '../data/services';
import { UPDATES } from '../data/news';
import { PROGRESS_ITEMS } from '../data/projects';
import { DESTINATIONS } from '../data/destinations';
import { SITE_META } from '../data/site';

const news = [...UPDATES]
  .sort((a, b) => b.publishedDate.localeCompare(a.publishedDate))
  .slice(0, 4);

const projects = PROGRESS_ITEMS.slice(0, 4);
const featuredDestinations = DESTINATIONS.filter(
  (d) =>
    d.slug === 'sto-nino-parish-church' ||
    d.slug === 'badiang-spring' ||
    d.slug === 'banderahan-ugjong-highlands'
);
---

<BaseLayout
  title="Municipality of Valencia, Bohol | BARUG VALENCIA"
  description="Municipality of Valencia, Province of Bohol (BARUG VALENCIA). Access municipal services, office directory, dated public announcements, infrastructure progress, and tourism guides."
>
  <!-- First Viewport: Full-Bleed Cinematic Video Hero with Curated Chapters, Independent Anthem Audio & Architectural Overlay -->
  <section class="hero hero-fullbleed" aria-label="Municipality of Valencia, Bohol Showcase">
    <div class="hero-video-bg">
      <video
        id="hero-video"
        autoplay
        muted
        playsinline
        preload="auto"
        poster="/media/valencia/valencia-church-plaza.jpg"
        aria-label="Cinematic showcase of Valencia, Bohol: Sto. Niño devotion, Panangatan River, and Sang-at Festival"
      >
        <source src="/media/valencia/valencia-hero-cinematic.mp4" type="video/mp4" />
      </video>
      <!-- Dedicated audio element synced to the festival song drop at 01:46 (106s) -->
      <audio
        id="hero-anthem-audio"
        preload="metadata"
        src="/media/valencia/valencia-hero-cinematic.mp4#t=106"
      ></audio>
      <div class="hero-video-overlay" aria-hidden="true"></div>
    </div>

    <div class="container hero-stage-shell">
      <!-- Top Bar: Official Identity Pill + Media & Anthem Controls -->
      <div class="hero-stage-top">
        <div class="hero-identity-pill hero-pill-glass">
          <span class="hero-catchphrase">BARUG VALENCIA</span>
          <span class="hero-divider" aria-hidden="true">·</span>
          <span>Municipality of Valencia, Province of Bohol</span>
        </div>

        <div class="hero-media-bar" role="group" aria-label="Video and soundtrack controls">
          <button
            id="hero-audio-toggle"
            type="button"
            class="hero-ctrl-btn hero-ctrl-audio"
            aria-pressed="false"
            title="Listen to the official Sang-at Festival celebration anthem"
          >
            <span class="audio-eq" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            <span id="hero-audio-label">Festival Anthem</span>
          </button>

          <button
            id="hero-video-toggle"
            type="button"
            class="hero-ctrl-btn"
            aria-label="Pause background video"
            title="Pause or play background video and soundtrack"
          >
            <span id="hero-video-icon">⏸ Pause</span>
          </button>
        </div>
      </div>

      <!-- Center Left: Clean Architectural Typography & Primary CTAs (Right 58% is open viewport) -->
      <div class="hero-stage-main">
        <div class="hero-content hero-content-overlay">
          <p class="hero-scene-tag" id="hero-scene-indicator">
            <span class="scene-dot" aria-hidden="true"></span>
            <span id="hero-scene-label">Chapter I · Coastal Devotion & Aerial Panorama</span>
          </p>

          <h1 class="hero-title-light">Valencia, Bohol.</h1>

          <p class="hero-copy hero-copy-light">
            Where the Panangatan River meets the Bohol Sea and 35 coastal and upland barangays stand together. Access municipal services, public announcements, community projects, and the natural and cultural landmarks of Valencia.
          </p>

          <div class="button-row">
            <a class="btn btn-primary btn-gold" href="/services">Municipal Services</a>
            <a class="btn btn-glass" href="/tourism">Explore Valencia</a>
          </div>
        </div>
      </div>

      <!-- Bottom Architectural Bar: Interactive Chapter Scrubber + Municipal Census Ledger -->
      <div class="hero-stage-bottom">
        <div class="hero-chapters" role="tablist" aria-label="Video chapters">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            class="hero-chapter-btn is-active"
            data-start="0"
            data-end="19.5"
            data-chapter="0"
            data-label="Chapter I · Coastal Devotion & Aerial Panorama"
          >
            <span class="chapter-index">01 · Devotion & Landscape</span>
            <strong>Coastal Devotion</strong>
            <span class="chapter-sub">Sto. Niño sea procession & valley panorama</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            class="hero-chapter-btn"
            data-start="19.5"
            data-end="35"
            data-chapter="1"
            data-label="Chapter II · Panangatan River & Boat-Lifting Origins"
          >
            <span class="chapter-index">02 · Maritime Heritage</span>
            <strong>Panangatan River</strong>
            <span class="chapter-sub">Traditional sang-at & riverbank landing</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            class="hero-chapter-btn"
            data-start="106"
            data-end="262"
            data-chapter="2"
            data-label="Chapter III · Sang-at Festival & Community Celebration"
          >
            <span class="chapter-index">03 · Cultural Celebration</span>
            <strong>Sang–at Festival</strong>
            <span class="chapter-sub">Town street dancing, rhythm & finale</span>
          </button>
        </div>

        <dl class="hero-facts hero-facts-glass" aria-label="Municipal key figures">
          <div>
            <dt>Population (2024)</dt>
            <dd>{SITE_META.population2024}</dd>
          </div>
          <div>
            <dt>Barangays</dt>
            <dd>35 Coastal & Upland</dd>
          </div>
          <div>
            <dt>District & PSGC</dt>
            <dd>3rd District · 0701247000</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Primary Municipal Actions Band -->
  <nav class="civic-action-band" aria-label="Primary municipal actions">
    <div class="container civic-action-grid">
      <a href="/services" class="civic-action-item">
        <strong>Municipal Services</strong>
        <span>Civil registry, permits, treasury, health & social welfare</span>
      </a>
      <a href="/government" class="civic-action-item">
        <strong>Offices & Governance</strong>
        <span>Executive, Sangguniang Bayan & Municipal Hall directory</span>
      </a>
      <a href="/municipality#barangays" class="civic-action-item">
        <strong>35 Barangays Directory</strong>
        <span>Search coastal and interior farming communities</span>
      </a>
      <a href="/transparency" class="civic-action-item">
        <strong>Transparency & Records</strong>
        <span>Full Disclosure portal, PSA census & development plans</span>
      </a>
    </div>
  </nav>

  <!-- 1. The Real Valencia: Agri-Coastal Landscape & Commercial Heart -->
  <section class="section" id="landscape">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Municipal Profile · PSGC 0701247000</p>
          <h2>An Agri-Coastal Economy Powered by Community Trade</h2>
          <p class="section-description">
            Stretching across 116.67 km² along southern Bohol, Valencia combines marine fisheries along the Bohol Sea with a productive interior agricultural heartland of 15 rice-growing barangays and copra plantations.
          </p>
        </div>
        <a class="text-link" href="/municipality">Learn about Valencia's geography & history →</a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-top: 16px;">
        <!-- Card 1: Valencia Business Center -->
        <article style="background: #ffffff; border: 1px solid var(--valencia-orange-border); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
          <div style="position: relative; height: 220px; overflow: hidden;">
            <img
              src="/media/valencia/valencia-business-center-day.jpg"
              alt="Modernized Valencia Business Center commercial portico in Poblacion"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
              loading="eager"
            />
            <span class="badge badge-orange" style="position: absolute; bottom: 12px; left: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.3);">
              Commercial Trading Center
            </span>
          </div>
          <div style="padding: 22px; flex: 1; display: flex; flex-direction: column;">
            <small style="color: var(--valencia-orange-dark); font-weight: 700; text-transform: uppercase; font-size: 0.76rem;">Poblacion Center</small>
            <h3 style="margin: 6px 0 10px; font-size: 1.25rem; color: var(--forest);">Valencia Business Center & Sunday Tabu</h3>
            <p style="font-size: 0.88rem; line-height: 1.6; color: var(--muted); margin-bottom: 16px; flex: 1;">
              The heart of municipal commerce. Every Sunday, interior farming households and coastal fishermen gather at the modernized two-storey commercial complex for the weekly Tabu trade, now upgraded with QR Ph digital payments.
            </p>
            <a href="/stories/sunday-tabu-and-crafts" class="text-link" style="font-weight: 600;">Explore Business Center & Tabu Trade →</a>
          </div>
        </article>

        <!-- Card 2: Agricultural Heartland -->
        <article style="background: #ffffff; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
          <div style="position: relative; height: 220px; overflow: hidden; background: var(--forest-2);">
            <img
              src="/media/valencia/valencia-town-view.jpg"
              alt="Coastal highway and interior farming corridor entering Valencia"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
              loading="eager"
            />
            <span class="tag" style="position: absolute; bottom: 12px; left: 14px; background: rgba(0,0,0,0.7); color: #ffffff; border: 1px solid rgba(255,255,255,0.2);">
              15 Rice & Coconut Barangays
            </span>
          </div>
          <div style="padding: 22px; flex: 1; display: flex; flex-direction: column;">
            <small style="color: var(--muted); font-weight: 700; text-transform: uppercase; font-size: 0.76rem;">Interior & Highland Belt</small>
            <h3 style="margin: 6px 0 10px; font-size: 1.25rem; color: var(--forest);">Agricultural Heartland & Rural Livelihoods</h3>
            <p style="font-size: 0.88rem; line-height: 1.6; color: var(--muted); margin-bottom: 16px; flex: 1;">
              Over half of Valencia's territory is cultivated in rice, coconut copra, corn, and fruit trees across rural communities like Anonang, Anoyon, Adlawan, and Pangi-an, supported by regional DA and municipal livestock recovery programs.
            </p>
            <a href="/municipality#barangays" class="text-link" style="font-weight: 600;">Browse 25 Upland & Interior Barangays →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 2. Frontline Resident Services & Requirements Hub -->
  <section class="section section-stone" id="services">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Resident & Business Frontline</p>
          <h2>Municipal Hall Frontline Services</h2>
          <p class="section-description">
            Transparent documentary requirements, responsible departments, and cashier guidelines for resident transactions at Valencia Municipal Hall.
          </p>
        </div>
        <a class="text-link" href="/services">View complete service catalog →</a>
      </div>

      <div class="service-grid">
        {SERVICE_CATEGORIES.map((s) => (
          <ServiceCard item={s} />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Dual-Feed: Recent Public Announcements & Verified Project Progress -->
  <section class="section" id="news-and-projects">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 36px;">
        <!-- Left Column: News & Advisories -->
        <div>
          <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; border-bottom: 2px solid var(--valencia-orange); padding-bottom: 10px;">
            <div>
              <p class="section-kicker" style="margin-bottom: 4px;">Public Information</p>
              <h2 style="margin: 0; font-size: 1.5rem;">News & Announcements</h2>
            </div>
            <a class="text-link" href="/news" style="font-size: 0.86rem;">All news →</a>
          </div>
          <div class="news-list" style="margin-top: 16px;">
            {news.map((item) => (
              <NewsRow item={item} />
            ))}
          </div>
        </div>

        <!-- Right Column: Projects & Progress -->
        <div>
          <div style="display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; border-bottom: 2px solid var(--valencia-orange); padding-bottom: 10px;">
            <div>
              <p class="section-kicker" style="margin-bottom: 4px;">BARUG VALENCIA in Action</p>
              <h2 style="margin: 0; font-size: 1.5rem;">Infrastructure & Programs</h2>
            </div>
            <a class="text-link" href="/projects" style="font-size: 0.86rem;">Full register →</a>
          </div>
          <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 16px;">
            {projects.map((p) => (
              <article style="background: var(--mint); border: 1px solid var(--line); border-left: 4px solid var(--valencia-orange); border-radius: 6px; padding: 16px 18px; display: flex; flex-direction: column; gap: 6px;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                  <span class="badge badge-orange" style="font-size: 0.7rem; padding: 2px 7px;">{p.statusBadge}</span>
                  <small style="color: var(--muted); font-size: 0.78rem;">{p.dateLabel}</small>
                </div>
                <h3 style="margin: 4px 0 2px; font-size: 1.05rem;">
                  <a href={`/projects/${p.slug}`} style="color: var(--forest); text-decoration: none;">
                    {p.title}
                  </a>
                </h3>
                <p style="font-size: 0.84rem; color: var(--ink); margin: 0; line-height: 1.5;">
                  {p.summary}
                </p>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(0,0,0,0.06);">
                  <span style="font-size: 0.76rem; color: var(--muted);">{p.barangay}</span>
                  <a href={`/projects/${p.slug}`} class="text-link" style="font-size: 0.8rem; font-weight: 600;">Details →</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Real Tourism Anchors: Santo Niño Church, Badiang Spring & Sang-at -->
  <section class="section section-forest" id="discover">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker light">Heritage & Natural Wonders</p>
          <h2>The Authentic Destinations of Valencia</h2>
          <p class="section-description">
            From the 1882 tindalo-and-molave hardwood floor of Sr. Santo Niño Parish Church to cold subterranean waters cascading into the Bohol Sea at Badiang Spring.
          </p>
        </div>
        <a class="text-link light" href="/tourism">View destination catalog →</a>
      </div>

      <div class="showcase-feature-grid">
        <a href="/culture/sang-at" class="showcase-lead-card">
          <div class="showcase-lead-media">
            <img
              src="/media/valencia/santo-nino-parish-arch.jpg"
              alt="Flame tree canopy and stone belfry of Sr. Santo Niño Parish Church in Poblacion Occidental, Valencia, Bohol"
              loading="eager"
            />
          </div>
          <div class="showcase-lead-body">
            <span class="showcase-pill">Foundation Day Cultural Signature · Late October</span>
            <h3>Sang-at Festival & Panangatan Heritage</h3>
            <p>
              Rooted in the Cebuano verb <em>sang-at</em>—how early coastal fishermen lifted their wooden outrigger boats onto the elevated, nipa-lined banks of the Panangatan River during the monsoon. Celebrated with street dancing every October.
            </p>
            <span class="showcase-cta">Read the Sang-at cultural profile →</span>
          </div>
        </a>

        <div class="destination-grid">
          {featuredDestinations.map((d) => (
            <a class="destination-card" href={`/tourism/${d.slug}`}>
              <MediaPanel
                slotId={d.mediaSlotId}
                label={d.name}
                caption={d.barangay}
              />
              <div class="destination-card-body">
                <small>{d.barangay} · {d.category}</small>
                <h3>{d.name}</h3>
                <p>{d.summary}</p>
                <span class="destination-link-text">Explore destination guide →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Municipality & 35 Barangays Profile Band -->
  <section class="section">
    <div class="container profile-grid">
      <div>
        <p class="section-kicker">Municipal Geography</p>
        <h2>One Community Across 35 Barangays</h2>
        <p class="section-lead">
          From coastal fishing villages along the southern shoreline to the commercial heart in Poblacion and rolling upland farm ridges rising to 485 meters at Banderahan.
        </p>
        <div class="stats">
          <div class="stat">
            <strong>{SITE_META.population2024}</strong>
            <span>2024 Census of Population (PSA)</span>
          </div>
          <div class="stat">
            <strong>35</strong>
            <span>10 Coastal · 25 Upland & Interior</span>
          </div>
          <div class="stat">
            <strong>116.67 km²</strong>
            <span>Land Area (Agri-Coastal)</span>
          </div>
        </div>
        <div class="button-row" style="margin-top: 28px;">
          <a href="/municipality" class="btn btn-primary">Municipal Profile & History</a>
          <a href="/municipality#barangays" class="btn btn-outline">Search 35 Barangays Directory</a>
        </div>
      </div>

      <div class="profile-map-card">
        <div class="profile-map-visual">
          <img
            src="/media/valencia/bohol-locator-valencia.png"
            alt="Map of Bohol showing the location of the Municipality of Valencia on the southern coast"
            loading="eager"
          />
        </div>
        <div class="profile-map-details">
          <h3>Geographic Overview</h3>
          <dl>
            <div>
              <dt>Province & Region</dt>
              <dd>Bohol · Central Visayas (Region VII)</dd>
            </div>
            <div>
              <dt>Congressional District</dt>
              <dd>3rd Congressional District</dd>
            </div>
            <div>
              <dt>Adjacent Municipalities</dt>
              <dd>Dimiao (West), Garcia Hernandez (East), Carmen & Sierra Bullones (North)</dd>
            </div>
            <div>
              <dt>Commercial Center</dt>
              <dd>Valencia Business Center (Poblacion)</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Practical Contact & Public Channels Strip -->
  <section class="section section-stone">
    <div class="container contact-strip">
      <div>
        <p class="section-kicker">Official Communication Channels</p>
        <h2>Connect with the Municipality of Valencia</h2>
        <p class="section-description">
          Reach municipal offices at Valencia Municipal Hall in Poblacion, follow official public advisories from the Local Government Unit, or plan your overland travel along the southern Bohol coastal road.
        </p>
      </div>
      <div class="contact-actions">
        <a href="/contact" class="btn btn-primary">Contact & Directions</a>
        <a
          href="https://www.facebook.com/lguvalofficialpage"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          LGU Valencia Facebook ↗
        </a>
      </div>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('#hero-video');
    const audio = document.querySelector<HTMLAudioElement>('#hero-anthem-audio');
    const toggle = document.querySelector<HTMLButtonElement>('#hero-video-toggle');
    const icon = document.querySelector<HTMLElement>('#hero-video-icon');
    const audioToggle = document.querySelector<HTMLButtonElement>('#hero-audio-toggle');
    const audioLabel = document.querySelector<HTMLElement>('#hero-audio-label');
    const sceneLabel = document.querySelector<HTMLElement>('#hero-scene-label');
    const chapterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero-chapter-btn'));

    const CHAPTERS = [
      {
        index: 0,
        start: 0,
        end: 19.5,
        label: 'Chapter I · Coastal Devotion & Aerial Panorama'
      },
      {
        index: 1,
        start: 19.5,
        end: 35,
        label: 'Chapter II · Panangatan River & Boat-Lifting Origins'
      },
      {
        index: 2,
        start: 106,
        end: 262,
        label: 'Chapter III · Sang-at Festival & Community Celebration'
      }
    ];

    let activeChapterIndex = -1;
    let isSeeking = false;

    function setActiveChapterUI(idx: number) {
      if (activeChapterIndex === idx) return;
      activeChapterIndex = idx;
      const ch = CHAPTERS[idx] || CHAPTERS[0];
      if (sceneLabel) {
        sceneLabel.textContent = ch.label;
      }
      chapterBtns.forEach((btn, i) => {
        const active = i === idx;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    if (video) {
      // Curated video timeline:
      // 0:00 -> 0:19.5 (Chapter I: Coastal Devotion & Aerial Panorama)
      // 0:19.5 -> 0:35 (Chapter II: Panangatan River & Boat-Lifting)
      // Skips slow 0:35–1:46 talk/intro directly to 1:46 (106s) for Chapter III: Sang-at Festival
      video.addEventListener('timeupdate', () => {
        if (isSeeking) return;
        const t = video.currentTime;

        if (t >= 35 && t < 105.5) {
          isSeeking = true;
          video.currentTime = 106;
          setActiveChapterUI(2);
          setTimeout(() => {
            isSeeking = false;
          }, 150);
          return;
        }

        if (t >= 262) {
          isSeeking = true;
          video.currentTime = 0;
          setActiveChapterUI(0);
          setTimeout(() => {
            isSeeking = false;
          }, 150);
          return;
        }

        if (t < 19.5) {
          setActiveChapterUI(0);
        } else if (t >= 19.5 && t < 35) {
          setActiveChapterUI(1);
        } else if (t >= 105.5) {
          setActiveChapterUI(2);
        }
      });

      chapterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const start = parseFloat(btn.dataset.start || '0');
          const idx = parseInt(btn.dataset.chapter || '0', 10);
          isSeeking = true;
          video.currentTime = start;
          if (video.paused) {
            video.play();
            if (icon) icon.textContent = '⏸ Pause';
            if (audio && audio.paused) {
              startAudio();
            }
          }
          setActiveChapterUI(idx);
          setTimeout(() => {
            isSeeking = false;
          }, 200);
        });
      });
    }

    // Audio Player State & Controls (Festival Anthem at 01:46 / 106s)
    const SONG_START = 106;
    const SONG_END = 268;

    async function startAudio() {
      if (!audio) return;
      if (audio.currentTime < SONG_START || audio.currentTime >= SONG_END) {
        audio.currentTime = SONG_START;
      }
      try {
        await audio.play();
        if (audioToggle) {
          audioToggle.classList.add('is-playing');
          audioToggle.setAttribute('aria-pressed', 'true');
        }
        if (audioLabel) {
          audioLabel.textContent = 'Sound On · Festival Anthem';
        }
      } catch {
        // Browser autoplay policy might require first user gesture
        if (audioToggle) {
          audioToggle.classList.remove('is-playing');
          audioToggle.setAttribute('aria-pressed', 'false');
        }
        if (audioLabel) {
          audioLabel.textContent = 'Festival Anthem';
        }
      }
    }

    function pauseAudio() {
      if (!audio) return;
      audio.pause();
      if (audioToggle) {
        audioToggle.classList.remove('is-playing');
        audioToggle.setAttribute('aria-pressed', 'false');
      }
      if (audioLabel) {
        audioLabel.textContent = 'Muted · Festival Anthem';
      }
    }

    if (audio) {
      audio.addEventListener('loadedmetadata', () => {
        if (audio.currentTime < SONG_START) {
          audio.currentTime = SONG_START;
        }
      });

      audio.addEventListener('timeupdate', () => {
        if (audio.currentTime >= SONG_END) {
          audio.currentTime = SONG_START;
          audio.play();
        }
      });
    }

    // Master Video + Audio Pause/Play Toggle
    if (toggle && icon) {
      toggle.addEventListener('click', () => {
        if (video) {
          if (video.paused) {
            video.play();
            icon.textContent = '⏸ Pause';
            toggle.setAttribute('aria-label', 'Pause background video');
            // Resume audio when resuming video if previously active or requested
            startAudio();
          } else {
            video.pause();
            icon.textContent = '▶ Play';
            toggle.setAttribute('aria-label', 'Play background video');
            // Stop audio when video is paused
            pauseAudio();
          }
        }
      });
    }

    if (audioToggle) {
      audioToggle.addEventListener('click', () => {
        if (!audio) return;
        if (audio.paused) {
          startAudio();
          if (video && video.paused) {
            video.play();
            if (icon) icon.textContent = '⏸ Pause';
          }
        } else {
          pauseAudio();
        }
      });
    }

    // Auto-start music when page/tab opens
    // (If modern browser blocks un-gestured autoplay with sound, gracefully attach to first click/touch/scroll)
    async function attemptAutoplayAudio() {
      try {
        await startAudio();
      } catch {
        const unlock = () => {
          startAudio();
          window.removeEventListener('click', unlock);
          window.removeEventListener('keydown', unlock);
          window.removeEventListener('touchstart', unlock);
          window.removeEventListener('scroll', unlock);
        };
        window.addEventListener('click', unlock, { once: true });
        window.addEventListener('keydown', unlock, { once: true });
        window.addEventListener('touchstart', unlock, { once: true });
        window.addEventListener('scroll', unlock, { once: true });
      }
    }

    if (document.readyState === 'complete') {
      attemptAutoplayAudio();
    } else {
      window.addEventListener('load', attemptAutoplayAudio);
    }
  </script>
</BaseLayout>
