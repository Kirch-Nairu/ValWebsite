---
import BaseLayout from '../layouts/BaseLayout.astro';
import MediaPanel from '../components/MediaPanel.astro';
import { UPDATES } from '../data/news';
import { PROGRESS_ITEMS } from '../data/projects';
import { DESTINATIONS } from '../data/destinations';
import { SITE_META } from '../data/site';

const news = [...UPDATES]
  .sort((a, b) => b.publishedDate.localeCompare(a.publishedDate))
  .slice(0, 4);

const projects = PROGRESS_ITEMS.slice(0, 4);
const destinationOrder = [
  'sto-nino-parish-church',
  'badiang-spring',
  'anislag-spring',
  'banderahan-ugjong-highlands'
];
const featuredDestinations = destinationOrder
  .map((slug) => DESTINATIONS.find((d) => d.slug === slug))
  .filter((d): d is typeof DESTINATIONS[0] => Boolean(d));
---

<BaseLayout
  title="Municipality of Valencia, Bohol | BARUG VALENCIA"
  description="Municipality of Valencia, Province of Bohol (BARUG VALENCIA). Access municipal services, office directory, dated public announcements, infrastructure progress, and tourism guides."
>
  <!-- First Viewport: Full-Bleed Cinematic Video Hero with Curated Chapters, Independent Anthem Audio & Architectural Overlay -->
  <section class="hero hero-fullbleed" aria-label="Municipality of Valencia, Bohol Showcase">
    <div class="hero-video-bg">
      <video
        id="hero-video"
        autoplay
        muted
        playsinline
        preload="auto"
        poster="/media/valencia/valencia-church-plaza.jpg"
        aria-label="Cinematic showcase of Valencia, Bohol: Sto. Niño devotion, Panangatan River, and Sang-at Festival"
      >
        <source src="/media/valencia/valencia-hero-cinematic.mp4" type="video/mp4" />
      </video>
      <!-- Dedicated audio element synced to the festival song drop at 01:46 (106s) -->
      <audio
        id="hero-anthem-audio"
        preload="metadata"
        src="/media/valencia/valencia-hero-cinematic.mp4#t=106"
      ></audio>
      <div class="hero-video-overlay" aria-hidden="true"></div>
    </div>

    <div class="container hero-stage-shell">
      <!-- Top Bar: Official Identity Pill + Media & Anthem Controls -->
      <div class="hero-stage-top">
        <div class="hero-identity-pill hero-pill-glass">
          <span class="hero-catchphrase">BARUG VALENCIA</span>
          <span class="hero-divider" aria-hidden="true">·</span>
          <span>Municipality of Valencia, Province of Bohol</span>
        </div>

        <div class="hero-media-bar" role="group" aria-label="Video and soundtrack controls">
          <button
            id="hero-audio-toggle"
            type="button"
            class="hero-ctrl-btn hero-ctrl-audio"
            aria-pressed="false"
            title="Listen to the official Sang-at Festival celebration anthem"
          >
            <span class="audio-eq" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            <span id="hero-audio-label">Festival Anthem</span>
          </button>

          <button
            id="hero-video-toggle"
            type="button"
            class="hero-ctrl-btn"
            aria-label="Pause background video"
            title="Pause or play background video and soundtrack"
          >
            <span id="hero-video-icon">⏸ Pause</span>
          </button>
        </div>
      </div>

      <!-- Center Left: Clean Architectural Typography & Primary CTAs (Right 58% is open viewport) -->
      <div class="hero-stage-main">
        <div class="hero-content hero-content-overlay">
          <p class="hero-scene-tag" id="hero-scene-indicator">
            <span class="scene-dot" aria-hidden="true"></span>
            <span id="hero-scene-label">Chapter I · Coastal Devotion & Aerial Panorama</span>
          </p>

          <h1 class="hero-title-light">Valencia, Bohol.</h1>

          <p class="hero-copy hero-copy-light">
            Where the Panangatan River meets the Bohol Sea and 35 coastal and upland barangays stand together. Access municipal services, public announcements, community projects, and the natural and cultural landmarks of Valencia.
          </p>

          <div class="button-row">
            <a class="btn btn-primary btn-gold" href="/services">Municipal Services</a>
            <a class="btn btn-glass" href="/tourism">Explore Valencia</a>
          </div>
        </div>
      </div>

      <!-- Bottom Architectural Bar: Interactive Chapter Scrubber + Municipal Census Ledger -->
      <div class="hero-stage-bottom">
        <div class="hero-chapters" role="tablist" aria-label="Video chapters">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            class="hero-chapter-btn is-active"
            data-start="0"
            data-end="19.5"
            data-chapter="0"
            data-label="Chapter I · Coastal Devotion & Aerial Panorama"
          >
            <span class="chapter-index">01 · Devotion & Landscape</span>
            <strong>Coastal Devotion</strong>
            <span class="chapter-sub">Sto. Niño sea procession & valley panorama</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            class="hero-chapter-btn"
            data-start="19.5"
            data-end="35"
            data-chapter="1"
            data-label="Chapter II · Panangatan River & Boat-Lifting Origins"
          >
            <span class="chapter-index">02 · Maritime Heritage</span>
            <strong>Panangatan River</strong>
            <span class="chapter-sub">Traditional sang-at & riverbank landing</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            class="hero-chapter-btn"
            data-start="106"
            data-end="262"
            data-chapter="2"
            data-label="Chapter III · Sang-at Festival & Community Celebration"
          >
            <span class="chapter-index">03 · Cultural Celebration</span>
            <strong>Sang–at Festival</strong>
            <span class="chapter-sub">Town street dancing, rhythm & finale</span>
          </button>
        </div>

        <dl class="hero-facts hero-facts-glass" aria-label="Municipal key figures">
          <div>
            <dt>Population (2024)</dt>
            <dd>{SITE_META.population2024}</dd>
          </div>
          <div>
            <dt>Barangays</dt>
            <dd>35 Coastal & Upland</dd>
          </div>
          <div>
            <dt>District & PSGC</dt>
            <dd>3rd District · 0701247000</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Primary Municipal Actions Band -->
  <nav class="civic-action-band" aria-label="Primary municipal actions">
    <div class="container civic-action-grid">
      <a href="/services" class="civic-action-item">
        <strong>Municipal Services</strong>
        <span>Civil registry, permits, treasury, health & social welfare</span>
      </a>
      <a href="/government" class="civic-action-item">
        <strong>Offices & Governance</strong>
        <span>Executive, Sangguniang Bayan & Municipal Hall directory</span>
      </a>
      <a href="/municipality#barangays" class="civic-action-item">
        <strong>35 Barangays Directory</strong>
        <span>Search coastal and interior farming communities</span>
      </a>
      <a href="/transparency" class="civic-action-item">
        <strong>Transparency & Records</strong>
        <span>Full Disclosure portal, PSA census & development plans</span>
      </a>
    </div>
  </nav>

  <!-- 1. The Real Valencia: Agri-Coastal Landscape & Commercial Heart -->
  <section class="section" id="landscape">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Municipal Profile · PSGC 0701247000</p>
          <h2>An Agri-Coastal Economy Powered by Community Trade</h2>
          <p class="section-description">
            Stretching across 116.67 km² along southern Bohol, Valencia combines marine fisheries along the Bohol Sea with a productive interior agricultural heartland of 15 rice-growing barangays and copra plantations.
          </p>
        </div>
        <a class="text-link" href="/municipality">Learn about Valencia's geography & history →</a>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px; margin-top: 16px;">
        <!-- Card 1: Valencia Business Center -->
        <article style="background: #ffffff; border: 1px solid var(--valencia-orange-border); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
          <div style="position: relative; height: 220px; overflow: hidden;">
            <img
              src="/media/valencia/valencia-business-center-day.jpg"
              alt="Modernized Valencia Business Center commercial portico in Poblacion"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
              loading="eager"
            />
            <span class="badge badge-orange" style="position: absolute; bottom: 12px; left: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.3);">
              Commercial Trading Center
            </span>
          </div>
          <div style="padding: 22px; flex: 1; display: flex; flex-direction: column;">
            <small style="color: var(--valencia-orange-dark); font-weight: 700; text-transform: uppercase; font-size: 0.76rem;">Poblacion Center</small>
            <h3 style="margin: 6px 0 10px; font-size: 1.25rem; color: var(--forest);">Valencia Business Center & Sunday Tabu</h3>
            <p style="font-size: 0.88rem; line-height: 1.6; color: var(--muted); margin-bottom: 16px; flex: 1;">
              The heart of municipal commerce. Every Sunday, interior farming households and coastal fishermen gather at the modernized two-storey commercial complex for the weekly Tabu trade, now upgraded with QR Ph digital payments.
            </p>
            <a href="/stories/sunday-tabu-and-crafts" class="text-link" style="font-weight: 600;">Explore Business Center & Tabu Trade →</a>
          </div>
        </article>

        <!-- Card 2: Agricultural Heartland -->
        <article style="background: #ffffff; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 16px rgba(0,0,0,0.04);">
          <div style="position: relative; height: 220px; overflow: hidden; background: var(--forest-2);">
            <img
              src="/media/valencia/valencia-town-view.jpg"
              alt="Coastal highway and interior farming corridor entering Valencia"
              style="width: 100%; height: 100%; object-fit: cover; display: block;"
              loading="eager"
            />
            <span class="tag" style="position: absolute; bottom: 12px; left: 14px; background: rgba(0,0,0,0.7); color: #ffffff; border: 1px solid rgba(255,255,255,0.2);">
              15 Rice & Coconut Barangays
            </span>
          </div>
          <div style="padding: 22px; flex: 1; display: flex; flex-direction: column;">
            <small style="color: var(--muted); font-weight: 700; text-transform: uppercase; font-size: 0.76rem;">Interior & Highland Belt</small>
            <h3 style="margin: 6px 0 10px; font-size: 1.25rem; color: var(--forest);">Agricultural Heartland & Rural Livelihoods</h3>
            <p style="font-size: 0.88rem; line-height: 1.6; color: var(--muted); margin-bottom: 16px; flex: 1;">
              Over half of Valencia's territory is cultivated in rice, coconut copra, corn, and fruit trees across rural communities like Anonang, Anoyon, Adlawan, and Pangi-an, supported by regional DA and municipal livestock recovery programs.
            </p>
            <a href="/municipality#barangays" class="text-link" style="font-weight: 600;">Browse 25 Upland & Interior Barangays →</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 2. Frontline Resident Services & Requirements Hub (Overlay on Valencia Municipal Hall Night Panorama) -->
  <section
    class="section"
    id="services"
    style="position: relative; padding: 72px 0; background: #0a1f1b url('/media/valencia/valencia-municipal-hall-night.jpg') center center / cover no-repeat; overflow: hidden;"
  >
    <!-- Dark Forest Architectural Overlay Gradient for Contrast and Readability -->
    <div
      style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10, 31, 27, 0.92) 0%, rgba(15, 45, 38, 0.86) 50%, rgba(10, 31, 27, 0.94) 100%); pointer-events: none;"
      aria-hidden="true"
    ></div>

    <div class="container" style="position: relative; z-index: 1;">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 28px; border-bottom: 2px solid rgba(223, 91, 30, 0.5); padding-bottom: 14px;">
        <div>
          <h2 style="margin: 0; font-size: 1.75rem; color: #ffffff;">Municipal Hall Frontline Services</h2>
          <p style="margin: 6px 0 0; color: #cbe0d8; font-size: 0.92rem;">
            Official windows at Valencia Municipal Hall (Poblacion) · Operating Weekdays 8:00 AM – 5:00 PM
          </p>
        </div>
        <a class="btn btn-orange" href="/services" style="font-size: 0.84rem; padding: 8px 16px;">
          View Full Citizen's Charter Catalog →
        </a>
      </div>

      <!-- Compact 4-Desk Visual Strip (Semi-translucent Frosted Cards) -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px;">
        <!-- Desk 1: Civil Registry -->
        <a
          href="/services/civil-registry"
          style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.4); border-top: 4px solid #df5b1e; border-radius: 8px; padding: 22px 20px; display: flex; flex-direction: column; text-decoration: none; transition: transform 0.15s ease, box-shadow 0.15s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.18);"
          onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 28px rgba(223,91,30,0.25)';"
          onmouseout="this.style.transform='none';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.18)';"
        >
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
            <span style="font-size: 0.72rem; font-weight: 700; color: #df5b1e; text-transform: uppercase; letter-spacing: 0.04em;">Ground Floor · MCR</span>
            <span class="tag" style="font-size: 0.68rem; padding: 2px 6px;">Vital Records</span>
          </div>
          <strong style="font-size: 1.08rem; color: var(--forest); display: block; margin-bottom: 6px;">Civil Registry & Records</strong>
          <p style="font-size: 0.84rem; line-height: 1.5; color: #4b5563; margin: 0 0 14px; flex: 1;">
            Birth, marriage, and death certificates, delayed registration, and PSA endorsements.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: #df5b1e;">Requirements & Fees →</span>
        </a>

        <!-- Desk 2: Treasury & BPLO -->
        <a
          href="/services/treasury-business-permits"
          style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.4); border-top: 4px solid #b88428; border-radius: 8px; padding: 22px 20px; display: flex; flex-direction: column; text-decoration: none; transition: transform 0.15s ease, box-shadow 0.15s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.18);"
          onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 28px rgba(184,132,40,0.25)';"
          onmouseout="this.style.transform='none';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.18)';"
        >
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
            <span style="font-size: 0.72rem; font-weight: 700; color: #b88428; text-transform: uppercase; letter-spacing: 0.04em;">Windows 1–4 · BPLO</span>
            <span class="tag" style="font-size: 0.68rem; padding: 2px 6px;">Cashier & Permits</span>
          </div>
          <strong style="font-size: 1.08rem; color: var(--forest); display: block; margin-bottom: 6px;">Treasury, Permits & Cedula</strong>
          <p style="font-size: 0.84rem; line-height: 1.5; color: #4b5563; margin: 0 0 14px; flex: 1;">
            Mayor's Permits, Real Property Tax (RPT), Community Tax, and Business Center stalls.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: #b88428;">Payment Windows →</span>
        </a>

        <!-- Desk 3: Social Welfare & Health -->
        <a
          href="/services/social-welfare-health"
          style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.4); border-top: 4px solid #14201d; border-radius: 8px; padding: 22px 20px; display: flex; flex-direction: column; text-decoration: none; transition: transform 0.15s ease, box-shadow 0.15s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.18);"
          onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 28px rgba(20,32,29,0.25)';"
          onmouseout="this.style.transform='none';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.18)';"
        >
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
            <span style="font-size: 0.72rem; font-weight: 700; color: var(--forest); text-transform: uppercase; letter-spacing: 0.04em;">MSWDO & RHU Clinics</span>
            <span class="tag" style="font-size: 0.68rem; padding: 2px 6px;">Community Aid</span>
          </div>
          <strong style="font-size: 1.08rem; color: var(--forest); display: block; margin-bottom: 6px;">Social Welfare & Health</strong>
          <p style="font-size: 0.84rem; line-height: 1.5; color: #4b5563; margin: 0 0 14px; flex: 1;">
            Duaw-Pamahaw outreach, AICS medical/burial assistance, Senior/PWD IDs, and RHU checkups.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--forest);">Assistance Guidelines →</span>
        </a>

        <!-- Desk 4: Agriculture & Environment -->
        <a
          href="/services/agriculture-environment-tourism"
          style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.4); border-top: 4px solid #2d6a4f; border-radius: 8px; padding: 22px 20px; display: flex; flex-direction: column; text-decoration: none; transition: transform 0.15s ease, box-shadow 0.15s ease; box-shadow: 0 8px 24px rgba(0,0,0,0.18);"
          onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 12px 28px rgba(45,106,79,0.25)';"
          onmouseout="this.style.transform='none';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.18)';"
        >
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
            <span style="font-size: 0.72rem; font-weight: 700; color: #2d6a4f; text-transform: uppercase; letter-spacing: 0.04em;">MAO & Field Stations</span>
            <span class="tag" style="font-size: 0.68rem; padding: 2px 6px;">Farmers & Fishers</span>
          </div>
          <strong style="font-size: 1.08rem; color: var(--forest); display: block; margin-bottom: 6px;">Agriculture & Fisheries</strong>
          <p style="font-size: 0.84rem; line-height: 1.5; color: #4b5563; margin: 0 0 14px; flex: 1;">
            RSBSA farmer registration, rice seeds, livestock distribution, and coastal marine permits.
          </p>
          <span style="font-size: 0.8rem; font-weight: 700; color: #2d6a4f;">Farmer Programs →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Dedicated Section: Public Information, News & Municipal Bulletins -->
  <section class="section" id="news" style="padding: 56px 0;">
    <div class="container">
      <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; border-bottom: 2px solid var(--valencia-orange); padding-bottom: 12px;">
        <h2 style="margin: 0; font-size: 1.6rem; color: var(--forest);">Public Information & Announcements</h2>
        <a class="text-link" href="/news" style="font-weight: 600;">Browse All Municipal Bulletins →</a>
      </div>

      <!-- Visual Magazine Headline Grid (1 Lead Hero News + 3 Editorial Cards) -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        <!-- Lead Feature Dispatch -->
        {news.length > 0 && (
          <article style="background: var(--mint); border: 1px solid var(--valencia-orange-border); border-radius: 8px; padding: 26px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 4px 14px rgba(0,0,0,0.03);">
            <div>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
                <span class="tag" style="font-size: 0.74rem;">{news[0].category}</span>
                <time datetime={news[0].publishedDate} style="font-size: 0.82rem; color: var(--muted); font-weight: 600;">
                  {new Date(news[0].publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h3 style="margin: 0 0 12px; font-size: 1.3rem; line-height: 1.35; color: var(--forest);">
                <a href={`/news/${news[0].slug}`} style="color: inherit; text-decoration: none;">
                  {news[0].title}
                </a>
              </h3>
              <p style="font-size: 0.92rem; line-height: 1.6; color: var(--ink); margin-bottom: 18px;">
                {news[0].summary}
              </p>
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 14px;">
              <span style="font-size: 0.78rem; color: var(--muted); font-weight: 600;">Source: {news[0].publisher}</span>
              <a href={`/news/${news[0].slug}`} class="btn btn-primary" style="font-size: 0.8rem; padding: 6px 14px;">
                Read Full Dispatch →
              </a>
            </div>
          </article>
        )}

        <!-- Stacked 3 Secondary News Rows -->
        <div style="display: flex; flex-direction: column; gap: 14px;">
          {news.slice(1, 4).map((item) => (
            <article style="background: #ffffff; border: 1px solid var(--line); border-radius: 8px; padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; transition: border-color 0.15s ease;" onmouseover="this.style.borderColor='var(--valencia-orange-border)';" onmouseout="this.style.borderColor='var(--line)';">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
                <span class="tag" style="font-size: 0.7rem;">{item.category}</span>
                <time datetime={item.publishedDate} style="font-size: 0.78rem; color: var(--muted);">
                  {new Date(item.publishedDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h4 style="margin: 0; font-size: 1.02rem; line-height: 1.4;">
                <a href={`/news/${item.slug}`} style="color: var(--forest); text-decoration: none;">
                  {item.title}
                </a>
              </h4>
              <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 4px;">
                <span style="font-size: 0.76rem; color: var(--muted);">{item.publisher}</span>
                <a href={`/news/${item.slug}`} class="text-link" style="font-size: 0.8rem; font-weight: 600;">Read →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Dedicated Section: BARUG VALENCIA in Action (Visual Infrastructure Ledger) -->
  <section class="section section-stone" id="projects" style="padding: 56px 0;">
    <div class="container">
      <div style="display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 28px; border-bottom: 2px solid var(--valencia-orange); padding-bottom: 12px;">
        <h2 style="margin: 0; font-size: 1.6rem; color: var(--forest);">BARUG VALENCIA in Action: Infrastructure & Development</h2>
        <a class="text-link" href="/projects" style="font-weight: 600;">Open Complete Projects Register →</a>
      </div>

      <!-- 4-Card Visual Progress Grid with Distinct Milestones & Verification -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        {projects.map((p) => (
