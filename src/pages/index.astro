                Partner: {p.partnerOrDonor}
              </span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Real Tourism Anchors: Santo Niño Church, Badiang Spring & Sang-at -->
  <section class="section section-forest" id="discover">
