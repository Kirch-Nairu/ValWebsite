---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import NewsRow from '../components/NewsRow.astro';
import ProjectRow from '../components/ProjectRow.astro';
import MediaPanel from '../components/MediaPanel.astro';
import { SERVICE_CATEGORIES } from '../data/services';
import { UPDATES } from '../data/news';
import { PROGRESS_ITEMS } from '../data/projects';
import { DESTINATIONS } from '../data/destinations';
import { SITE_META } from '../data/site';

const news = [...UPDATES]
  .sort((a, b) => b.publishedDate.localeCompare(a.publishedDate))
  .slice(0, 4);

const projects = PROGRESS_ITEMS.slice(0, 4);
const featuredDestinations = DESTINATIONS.filter(
  (d) =>
    d.slug === 'sto-nino-parish-church' ||
    d.slug === 'badiang-spring' ||
    d.slug === 'canduao-pottery-capital' ||
    d.slug === 'banderahan-ugjong-highlands'
);
---

<BaseLayout
  title="Municipality of Valencia, Bohol | BARUG VALENCIA"
  description="Municipality of Valencia, Province of Bohol (BARUG VALENCIA). Access municipal services, office directory, dated public announcements, infrastructure progress, and tourism guides."
>
  <!-- First Viewport: Full-Bleed Cinematic Video Hero with Curated Chapters, Independent Anthem Audio & Architectural Overlay -->
  <section class="hero hero-fullbleed" aria-label="Municipality of Valencia, Bohol Showcase">
    <div class="hero-video-bg">
      <video
        id="hero-video"
        autoplay
        muted
        playsinline
        preload="auto"
        poster="/media/valencia/valencia-church-plaza.jpg"
        aria-label="Cinematic showcase of Valencia, Bohol: Sto. Niño devotion, Panangatan River, and Sang-at Festival"
      >
        <source src="/media/valencia/valencia-hero-cinematic.mp4" type="video/mp4" />
      </video>
      <!-- Dedicated audio element synced to the festival song drop at 01:46 (106s) -->
      <audio
        id="hero-anthem-audio"
        preload="metadata"
        src="/media/valencia/valencia-hero-cinematic.mp4#t=106"
      ></audio>
      <div class="hero-video-overlay" aria-hidden="true"></div>
    </div>

    <div class="container hero-stage-shell">
      <!-- Top Bar: Official Identity Pill + Media & Anthem Controls -->
      <div class="hero-stage-top">
        <div class="hero-identity-pill hero-pill-glass">
          <span class="hero-catchphrase">BARUG VALENCIA</span>
          <span class="hero-divider" aria-hidden="true">·</span>
          <span>Municipality of Valencia, Province of Bohol</span>
        </div>

        <div class="hero-media-bar" role="group" aria-label="Video and soundtrack controls">
          <button
            id="hero-audio-toggle"
            type="button"
            class="hero-ctrl-btn hero-ctrl-audio"
            aria-pressed="false"
            title="Listen to the official Sang-at Festival celebration anthem"
          >
            <span class="audio-eq" aria-hidden="true">
              <span></span><span></span><span></span>
            </span>
            <span id="hero-audio-label">Festival Anthem</span>
          </button>

          <button
            id="hero-video-toggle"
            type="button"
            class="hero-ctrl-btn"
            aria-label="Pause background video"
            title="Pause or play background video and soundtrack"
          >
            <span id="hero-video-icon">⏸ Pause</span>
          </button>
        </div>
      </div>

      <!-- Center Left: Clean Architectural Typography & Primary CTAs (Right 58% is open viewport) -->
      <div class="hero-stage-main">
        <div class="hero-content hero-content-overlay">
          <p class="hero-scene-tag" id="hero-scene-indicator">
            <span class="scene-dot" aria-hidden="true"></span>
            <span id="hero-scene-label">Chapter I · Coastal Devotion & Aerial Panorama</span>
          </p>

          <h1 class="hero-title-light">Valencia, Bohol.</h1>

          <p class="hero-copy hero-copy-light">
            Where the Panangatan River meets the Bohol Sea and 35 coastal and upland barangays stand together. Access municipal services, public announcements, community projects, and the natural and cultural landmarks of Valencia.
          </p>

          <div class="button-row">
            <a class="btn btn-primary btn-gold" href="/services">Municipal Services</a>
            <a class="btn btn-glass" href="/tourism">Explore Valencia</a>
          </div>
        </div>
      </div>

      <!-- Bottom Architectural Bar: Interactive Chapter Scrubber + Municipal Census Ledger -->
      <div class="hero-stage-bottom">
        <div class="hero-chapters" role="tablist" aria-label="Video chapters">
          <button
            type="button"
            role="tab"
            aria-selected="true"
            class="hero-chapter-btn is-active"
            data-start="0"
            data-end="19.5"
            data-chapter="0"
            data-label="Chapter I · Coastal Devotion & Aerial Panorama"
          >
            <span class="chapter-index">01 · Devotion & Landscape</span>
            <strong>Coastal Devotion</strong>
            <span class="chapter-sub">Sto. Niño sea procession & valley panorama</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            class="hero-chapter-btn"
            data-start="19.5"
            data-end="35"
            data-chapter="1"
            data-label="Chapter II · Panangatan River & Boat-Lifting Origins"
          >
            <span class="chapter-index">02 · Maritime Heritage</span>
            <strong>Panangatan River</strong>
            <span class="chapter-sub">Traditional sang-at & riverbank landing</span>
          </button>

          <button
            type="button"
            role="tab"
            aria-selected="false"
            class="hero-chapter-btn"
            data-start="106"
            data-end="262"
            data-chapter="2"
            data-label="Chapter III · Sang-at Festival & Community Celebration"
          >
            <span class="chapter-index">03 · Cultural Celebration</span>
            <strong>Sang–at Festival</strong>
            <span class="chapter-sub">Town street dancing, rhythm & finale</span>
          </button>
        </div>

        <dl class="hero-facts hero-facts-glass" aria-label="Municipal key figures">
          <div>
            <dt>Population (2024)</dt>
            <dd>{SITE_META.population2024}</dd>
          </div>
          <div>
            <dt>Barangays</dt>
            <dd>35 Coastal & Upland</dd>
          </div>
          <div>
            <dt>District & PSGC</dt>
            <dd>3rd District · 0701247000</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Primary Municipal Actions Band -->
  <nav class="civic-action-band" aria-label="Primary municipal actions">
    <div class="container civic-action-grid">
      <a href="/services" class="civic-action-item">
        <strong>Municipal Services</strong>
        <span>Civil registry, business permits, treasury, health & agriculture</span>
      </a>
      <a href="/government" class="civic-action-item">
        <strong>Offices & Governance</strong>
        <span>Executive, Sangguniang Bayan & functional office directory</span>
      </a>
      <a href="/municipality#barangays" class="civic-action-item">
        <strong>35 Barangays Directory</strong>
        <span>Search coastal and upland barangays and PSGC references</span>
      </a>
      <a href="/transparency" class="civic-action-item">
        <strong>Transparency & Records</strong>
        <span>DILG Full Disclosure portal, PSA census & provincial profiles</span>
      </a>
    </div>
  </nav>

  <!-- Municipal Services Section -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Resident & Business Guide</p>
          <h2>Municipal Services & Offices</h2>
          <p class="section-description">
            Direct guidance on documentary preparation, responsible departments, and in-person transactions at Valencia Municipal Hall.
          </p>
        </div>
        <a class="text-link" href="/services">View all service guides</a>
      </div>

      <div class="service-grid">
        {SERVICE_CATEGORIES.map((s) => (
          <ServiceCard item={s} />
        ))}
      </div>
    </div>
  </section>

  <!-- News & Public Announcements + Municipal Projects Split/Ledger -->
  <section class="section section-stone" id="news">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Public Information</p>
          <h2>Recent News & Announcements</h2>
          <p class="section-description">
            Dated reports covering municipal governance, classroom infrastructure, digital market payments, and cultural milestones in Valencia.
          </p>
        </div>
        <a class="text-link" href="/news">Browse all announcements</a>
      </div>

      <div class="news-list">
        {news.map((item) => (
          <NewsRow item={item} />
        ))}
      </div>
    </div>
  </section>

  <!-- Projects & Municipal Progress -->
  <section class="section" id="projects">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker">BARUG VALENCIA in Action</p>
          <h2>Municipal Projects & Development</h2>
          <p class="section-description">
            Completed educational facilities, public market modernization, agricultural recovery programs, and policy initiatives across Valencia’s barangays.
          </p>
        </div>
        <a href="/projects" class="text-link">Open full project register</a>
      </div>

      <div class="project-table">
        <div class="project-labels">
          <span>Project & Location</span>
          <span>Status</span>
          <span>Implementing Office / Partner</span>
          <span></span>
        </div>
        {projects.map((item) => (
          <ProjectRow item={item} />
        ))}
      </div>
    </div>
  </section>

  <!-- Photograph-Driven Discover Valencia & Sang-at Heritage Showcase -->
  <section class="section section-forest" id="discover">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-kicker light">Tourism, Culture & Heritage</p>
          <h2>From Coastal Springs to the Sang-at Festival</h2>
          <p class="section-description">
            Experience Badiang Spring where cold mountain water meets the Bohol Sea, walk across the 1882 tindalo-and-molave hardwood floor of Sr. Santo Niño Parish Church, and celebrate Valencia’s Panangatan boat-lifting heritage.
          </p>
        </div>
        <a class="text-link light" href="/tourism">Explore all 14 destinations</a>
      </div>

      <div class="showcase-feature-grid">
        <a href="/culture/sang-at" class="showcase-lead-card">
          <div class="showcase-lead-media">
            <img
              src="/media/valencia/santo-nino-parish-arch.jpg"
              alt="Flame tree canopy and stone belfry of Sr. Santo Niño Parish Church in Poblacion Occidental, Valencia, Bohol"
              loading="eager"
            />
          </div>
          <div class="showcase-lead-body">
            <span class="showcase-pill">Foundation Day Cultural Signature · Late October</span>
            <h3>Sang-at Festival & Panangatan Heritage</h3>
            <p>
              Rooted in the Cebuano verb <em>sang-at</em>—how early fishermen lifted their wooden outrigger boats onto the elevated, nipa-lined banks of the Panangatan River during the southwest monsoon. Featured at Bohol’s Sandugo showcase in July 2026.
            </p>
            <span class="showcase-cta">Read the Sang-at cultural profile →</span>
          </div>
        </a>

        <div class="destination-grid">
          {featuredDestinations.map((d) => (
            <a class="destination-card" href={`/tourism/${d.slug}`}>
              <MediaPanel
                slotId={d.mediaSlotId}
                label={d.name}
                caption={d.barangay}
              />
              <div class="destination-card-body">
                <small>{d.barangay} · {d.category}</small>
                <h3>{d.name}</h3>
                <p>{d.summary}</p>
                <span class="destination-link-text">Explore destination guide →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Municipality & 35 Barangays Profile Band -->
  <section class="section">
    <div class="container profile-grid">
      <div>
        <p class="section-kicker">Know Your Municipality</p>
        <h2>One Community Across 35 Barangays</h2>
        <p class="section-lead">
          Valencia spans coastal fishing and resort villages along the Bohol Sea, the commercial and heritage district of Poblacion, and upland agricultural communities rising to 485 meters at Banderahan and Limocon.
        </p>
        <div class="stats">
          <div class="stat">
            <strong>{SITE_META.population2024}</strong>
            <span>2024 Census of Population (PSA)</span>
          </div>
          <div class="stat">
            <strong>35</strong>
            <span>Coastal & Upland Barangays</span>
          </div>
          <div class="stat">
            <strong>1867 / 1869</strong>
            <span>Historical Foundation from Panangatan</span>
          </div>
        </div>
        <div class="button-row" style="margin-top: 28px;">
          <a href="/municipality" class="btn btn-primary">Municipal Profile & History</a>
          <a href="/municipality#barangays" class="btn btn-outline">Search 35 Barangays</a>
        </div>
      </div>

      <div class="profile-map-card">
        <div class="profile-map-visual">
          <img
            src="/media/valencia/bohol-locator-valencia.png"
            alt="Map of Bohol showing the location of the Municipality of Valencia on the southern coast"
            loading="eager"
          />
        </div>
        <div class="profile-map-details">
          <h3>Geographic Overview</h3>
          <dl>
            <div>
              <dt>Province & Region</dt>
              <dd>Bohol · Central Visayas (Region VII)</dd>
            </div>
            <div>
              <dt>Congressional District</dt>
              <dd>3rd Congressional District</dd>
            </div>
            <div>
              <dt>Adjacent Municipalities</dt>
              <dd>Dimiao (West), Garcia Hernandez (East), Carmen & Sierra Bullones (North)</dd>
            </div>
            <div>
              <dt>Weekly Market Day</dt>
              <dd>Sunday Tabu at Poblacion Public Market</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Practical Contact & Public Channels Strip -->
  <section class="section section-stone">
    <div class="container contact-strip">
      <div>
        <p class="section-kicker">Official Communication Channels</p>
        <h2>Connect with the Municipality of Valencia</h2>
        <p class="section-description">
          Reach municipal offices in Poblacion, follow official public advisories from the Local Government Unit, or plan your overland trip from Tagbilaran City.
        </p>
      </div>
      <div class="contact-actions">
        <a href="/contact" class="btn btn-primary">Contact & Directions</a>
        <a
          href="https://www.facebook.com/lguvalofficialpage"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          LGU Valencia Facebook ↗
        </a>
      </div>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('#hero-video');
    const audio = document.querySelector<HTMLAudioElement>('#hero-anthem-audio');
    const toggle = document.querySelector<HTMLButtonElement>('#hero-video-toggle');
    const icon = document.querySelector<HTMLElement>('#hero-video-icon');
    const audioToggle = document.querySelector<HTMLButtonElement>('#hero-audio-toggle');
    const audioLabel = document.querySelector<HTMLElement>('#hero-audio-label');
    const sceneLabel = document.querySelector<HTMLElement>('#hero-scene-label');
    const chapterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.hero-chapter-btn'));

    const CHAPTERS = [
      {
        index: 0,
        start: 0,
        end: 19.5,
        label: 'Chapter I · Coastal Devotion & Aerial Panorama'
      },
      {
        index: 1,
        start: 19.5,
        end: 35,
        label: 'Chapter II · Panangatan River & Boat-Lifting Origins'
      },
      {
        index: 2,
        start: 106,
        end: 262,
        label: 'Chapter III · Sang-at Festival & Community Celebration'
      }
    ];

    let activeChapterIndex = -1;
    let isSeeking = false;

    function setActiveChapterUI(idx: number) {
      if (activeChapterIndex === idx) return;
      activeChapterIndex = idx;
      const ch = CHAPTERS[idx] || CHAPTERS[0];
      if (sceneLabel) {
        sceneLabel.textContent = ch.label;
      }
      chapterBtns.forEach((btn, i) => {
        const active = i === idx;
        btn.classList.toggle('is-active', active);
        btn.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    }

    if (video) {
      // Curated video timeline:
      // 0:00 -> 0:19.5 (Chapter I: Coastal Devotion & Aerial Panorama)
      // 0:19.5 -> 0:35 (Chapter II: Panangatan River & Boat-Lifting)
      // Skips slow 0:35–1:46 talk/intro directly to 1:46 (106s) for Chapter III: Sang-at Festival
      video.addEventListener('timeupdate', () => {
        if (isSeeking) return;
        const t = video.currentTime;

        if (t >= 35 && t < 105.5) {
          isSeeking = true;
          video.currentTime = 106;
          setActiveChapterUI(2);
          setTimeout(() => {
            isSeeking = false;
          }, 150);
          return;
        }

        if (t >= 262) {
          isSeeking = true;
          video.currentTime = 0;
          setActiveChapterUI(0);
          setTimeout(() => {
            isSeeking = false;
          }, 150);
          return;
        }

        if (t < 19.5) {
          setActiveChapterUI(0);
        } else if (t >= 19.5 && t < 35) {
          setActiveChapterUI(1);
        } else if (t >= 105.5) {
          setActiveChapterUI(2);
        }
      });

      chapterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const start = parseFloat(btn.dataset.start || '0');
          const idx = parseInt(btn.dataset.chapter || '0', 10);
          isSeeking = true;
          video.currentTime = start;
          if (video.paused) {
            video.play();
            if (icon) icon.textContent = '⏸ Pause';
            if (audio && audio.paused) {
              startAudio();
            }
          }
          setActiveChapterUI(idx);
          setTimeout(() => {
            isSeeking = false;
          }, 200);
        });
      });
    }

    // Audio Player State & Controls (Festival Anthem at 01:46 / 106s)
    const SONG_START = 106;
    const SONG_END = 268;

    async function startAudio() {
      if (!audio) return;
      if (audio.currentTime < SONG_START || audio.currentTime >= SONG_END) {
        audio.currentTime = SONG_START;
      }
      try {
        await audio.play();
        if (audioToggle) {
          audioToggle.classList.add('is-playing');
          audioToggle.setAttribute('aria-pressed', 'true');
        }
        if (audioLabel) {
          audioLabel.textContent = 'Sound On · Festival Anthem';
        }
      } catch {
        // Browser autoplay policy might require first user gesture
        if (audioToggle) {
          audioToggle.classList.remove('is-playing');
          audioToggle.setAttribute('aria-pressed', 'false');
        }
        if (audioLabel) {
          audioLabel.textContent = 'Festival Anthem';
        }
      }
    }

    function pauseAudio() {
      if (!audio) return;
      audio.pause();
      if (audioToggle) {
        audioToggle.classList.remove('is-playing');
        audioToggle.setAttribute('aria-pressed', 'false');
      }
      if (audioLabel) {
        audioLabel.textContent = 'Muted · Festival Anthem';
      }
    }

    if (audio) {
      audio.addEventListener('loadedmetadata', () => {
        if (audio.currentTime < SONG_START) {
          audio.currentTime = SONG_START;
        }
      });

      audio.addEventListener('timeupdate', () => {
        if (audio.currentTime >= SONG_END) {
          audio.currentTime = SONG_START;
          audio.play();
        }
      });
    }

    // Master Video + Audio Pause/Play Toggle
    if (toggle && icon) {
      toggle.addEventListener('click', () => {
        if (video) {
          if (video.paused) {
            video.play();
            icon.textContent = '⏸ Pause';
            toggle.setAttribute('aria-label', 'Pause background video');
            // Resume audio when resuming video if previously active or requested
            startAudio();
          } else {
            video.pause();
            icon.textContent = '▶ Play';
            toggle.setAttribute('aria-label', 'Play background video');
            // Stop audio when video is paused
            pauseAudio();
          }
        }
      });
    }

    if (audioToggle) {
      audioToggle.addEventListener('click', () => {
        if (!audio) return;
        if (audio.paused) {
          startAudio();
          if (video && video.paused) {
            video.play();
            if (icon) icon.textContent = '⏸ Pause';
          }
        } else {
          pauseAudio();
        }
      });
    }

    // Auto-start music when page/tab opens
    // (If modern browser blocks un-gestured autoplay with sound, gracefully attach to first click/touch/scroll)
    async function attemptAutoplayAudio() {
      try {
        await startAudio();
      } catch {
        const unlock = () => {
          startAudio();
          window.removeEventListener('click', unlock);
          window.removeEventListener('keydown', unlock);
          window.removeEventListener('touchstart', unlock);
          window.removeEventListener('scroll', unlock);
        };
        window.addEventListener('click', unlock, { once: true });
        window.addEventListener('keydown', unlock, { once: true });
        window.addEventListener('touchstart', unlock, { once: true });
        window.addEventListener('scroll', unlock, { once: true });
      }
    }

    if (document.readyState === 'complete') {
      attemptAutoplayAudio();
    } else {
      window.addEventListener('load', attemptAutoplayAudio);
    }
  </script>
</BaseLayout>
