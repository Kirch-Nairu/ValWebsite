---
import '../styles/global.css';
import { SITE_META, SEARCH_INDEX, OFFICIAL_CHANNELS } from '../data/valenciaData';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'BARUG VALENCIA — Destination, culture, heritage, and municipal progress prototype for the Municipality of Valencia, Bohol (PSGC 0701247000).',
  currentPath = Astro.url.pathname
} = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Discover', href: '/discover' },
  { label: 'Culture & Heritage', href: '/culture' },
  { label: 'Our Valencia', href: '/valencia' },
  { label: 'Progress', href: '/progress' },
  { label: 'Updates', href: '/updates' },
  { label: 'Government', href: '/government' },
  { label: 'Contact', href: '/contact' }
];

function isCurrent(href: string, path: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'http://127.0.0.1:4321').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | BARUG VALENCIA — Valencia, Bohol</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | BARUG VALENCIA (Prototype)`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <div class="prototype-banner" role="region" aria-label="Prototype status disclosure">
      <div class="container prototype-banner-inner">
        <div>
          <span class="prototype-pill">Independent Prototype</span>
          <span>
            Not an official live municipal service · Municipality of Valencia, Bohol (PSGC <code>{SITE_META.psgcCode}</code>)
          </span>
        </div>
        <div>
          <span>2024 Census: <strong>{SITE_META.population2024}</strong> · <strong>35</strong> Barangays</span>
        </div>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand-lockup" aria-label="BARUG VALENCIA — Valencia, Bohol Home">
          <span class="brand-emblem" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 17c3 2 6 2 9 0s6-2 9 0" />
              <path d="M5 12l7-8 7 8" />
              <path d="M8 12h8" />
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-catchphrase">BARUG VALENCIA</span>
            <span class="brand-sub">Valencia, Bohol · Seal Pending Authorization</span>
          </span>
        </a>

        <nav class="desktop-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="nav-link"
              aria-current={isCurrent(item.href, currentPath) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="header-actions">
          <button
            type="button"
            class="search-trigger-btn"
            id="open-search-btn"
            aria-haspopup="dialog"
            aria-controls="site-search-modal"
            aria-expanded="false"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="M20 20l-3.5-3.5" />
            </svg>
            <span>Search</span>
            <kbd class="search-kbd">Ctrl K</kbd>
          </button>

          <button
            type="button"
            class="mobile-menu-btn"
            id="open-mobile-menu-btn"
            aria-controls="mobile-nav-drawer"
            aria-expanded="false"
            aria-label="Open navigation menu"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <span>Menu</span>
          </button>
        </div>
      </div>
    </header>

    <!-- Accessible Mobile Navigation Drawer -->
    <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" hidden>
      <aside
        class="mobile-drawer"
        id="mobile-nav-drawer"
        role="dialog"
        aria-modal="true"
        aria-label="Mobile navigation menu"
      >
        <div class="mobile-drawer-header">
          <div>
            <strong style="font-family: var(--font-display); letter-spacing: 0.05em;">BARUG VALENCIA</strong>
            <div style="font-size: 0.72rem; color: var(--ink-on-dark-muted);">Valencia, Bohol Navigation</div>
          </div>
          <button type="button" class="mobile-close-btn" id="close-mobile-menu-btn" aria-label="Close navigation menu">
            Close ✕
          </button>
        </div>

        <ul class="mobile-nav-list">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="mobile-nav-link"
                aria-current={isCurrent(item.href, currentPath) ? 'page' : undefined}
              >
                <span>{item.label}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/culture/sang-at" class="mobile-nav-link">
              <span>Sang-at Festival Feature</span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        </ul>

        <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-on-dark); font-size: 0.78rem; color: var(--ink-on-dark-muted);">
          <p style="margin: 0 0 0.5rem 0;">
            <strong>Independent Prototype Notice:</strong> All content is traceable to public records (`research/sources.csv`).
          </p>
        </div>
      </aside>
    </div>

    <!-- Accessible Site Search Modal -->
    <div class="search-modal-backdrop" id="site-search-modal" role="dialog" aria-modal="true" aria-label="Search Valencia website" hidden>
      <div class="search-modal">
        <div class="search-modal-header">
          <label for="global-search-input" style="font-weight: 700; font-size: 0.9rem;">Search:</label>
          <input
            type="search"
            id="global-search-input"
            class="search-input"
            placeholder="Search attractions, Sang-at, barangays, Anoyon, church floor, services..."
            autocomplete="off"
          />
          <button type="button" class="mobile-close-btn" id="close-search-btn" style="background: var(--bg-deep); color: #fff;">
            Esc ✕
          </button>
        </div>
        <div class="search-results-container" id="global-search-results" role="region" aria-live="polite">
          {SEARCH_INDEX.slice(0, 10).map((doc) => (
            <a href={doc.url} class="search-result-item" data-search-item data-keywords={doc.keywords}>
              <div class="search-result-meta">
                <span>{doc.section}</span>
                <span>•</span>
                <span>{doc.badge}</span>
              </div>
              <h3 class="search-result-title">{doc.title}</h3>
              <p class="search-result-summary">{doc.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </div>

    <noscript>
      <div class="container" style="padding-block: 0.75rem;">
        <div class="callout-box">
          <strong>JavaScript-Free Navigation Active:</strong> Use the top navigation links or jump directly to{' '}
          <a href="/discover">Discover Valencia</a>, <a href="/culture/sang-at">Sang-at Festival</a>,{' '}
          <a href="/valencia">35 Barangays</a>, <a href="/progress">Progress</a>, or <a href="/government">Government Services</a>.
        </div>
      </div>
    </noscript>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <div class="footer-heading">BARUG VALENCIA · Valencia, Bohol</div>
            <p style="margin-top: 0; color: #e5ece9;">
              A destination-led place-brand and public information prototype for the Municipality of Valencia, Province of Bohol
              (PSGC <code>0701247000</code> · 3rd District).
            </p>
            <p style="font-size: 0.8rem; margin-bottom: 0;">
              {SITE_META.prototypeDisclaimer}
            </p>
          </div>

          <div>
            <div class="footer-heading">Explore &amp; Stories</div>
            <ul class="footer-links">
              <li><a href="/discover">Discover 14 PPDO Sites</a></li>
              <li><a href="/discover/badiang-spring">Badiang Spring (Brgy. Anas)</a></li>
              <li><a href="/discover/sto-nino-parish-church">Sto. Niño Parish Church (1882)</a></li>
              <li><a href="/culture">Culture &amp; Heritage</a></li>
              <li><a href="/culture/sang-at">Sang-at Festival Feature</a></li>
              <li><a href="/stories/panangatan-origin">Panangatan Origin Story</a></li>
            </ul>
          </div>

          <div>
            <div class="footer-heading">Municipality &amp; Utility</div>
            <ul class="footer-links">
              <li><a href="/valencia">Our Valencia &amp; 35 Barangays</a></li>
              <li><a href="/progress">Verified Progress &amp; Projects</a></li>
              <li><a href="/updates">Dated News &amp; Event Archive</a></li>
              <li><a href="/government">Government &amp; Public Services</a></li>
              <li><a href="/contact">Official Channels &amp; Contact</a></li>
            </ul>
          </div>

          <div>
            <div class="footer-heading">Verified Source Channels</div>
            <ul class="footer-links">
              {OFFICIAL_CHANNELS.slice(0, 5).map((ch) => (
                <li>
                  <a href={ch.url} target="_blank" rel="noopener noreferrer">
                    {ch.name} ↗
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div style="padding-top: 1.5rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem; font-size: 0.78rem;">
          <div>
            <strong>Media &amp; Seal Governance:</strong> 0 third-party photos or official seals are published without license. All visual slots use custom SVG art direction with traceable candidate IDs (`R001`–`R021`).
          </div>
          <div>
            Baseline: <code>VAL-M01B-COMPLETE-LOCAL-PROTOTYPE</code> · Checked 2026-11-06
          </div>
        </div>
      </div>
    </footer>

    <script is:inline define:vars={{ SEARCH_INDEX }}>
      (() => {
        const mobileOpenBtn = document.getElementById('open-mobile-menu-btn');
        const mobileCloseBtn = document.getElementById('close-mobile-menu-btn');
        const mobileBackdrop = document.getElementById('mobile-drawer-backdrop');

        function setMobileDrawer(open) {
          if (!mobileBackdrop || !mobileOpenBtn) return;
          if (open) {
            mobileBackdrop.removeAttribute('hidden');
            mobileOpenBtn.setAttribute('aria-expanded', 'true');
            mobileCloseBtn?.focus();
          } else {
            mobileBackdrop.setAttribute('hidden', '');
            mobileOpenBtn.setAttribute('aria-expanded', 'false');
            mobileOpenBtn.focus();
          }
        }

        mobileOpenBtn?.addEventListener('click', () => setMobileDrawer(true));
        mobileCloseBtn?.addEventListener('click', () => setMobileDrawer(false));
        mobileBackdrop?.addEventListener('click', (e) => {
          if (e.target === mobileBackdrop) setMobileDrawer(false);
        });

        const searchOpenBtn = document.getElementById('open-search-btn');
        const searchCloseBtn = document.getElementById('close-search-btn');
        const searchModal = document.getElementById('site-search-modal');
        const searchInput = document.getElementById('global-search-input');
        const searchResults = document.getElementById('global-search-results');

        function renderSearchResults(query) {
          if (!searchResults) return;
          const q = (query || '').trim().toLowerCase();
          const matches = !q
            ? SEARCH_INDEX
            : SEARCH_INDEX.filter((item) => {
                const hay = `${item.title} ${item.summary} ${item.keywords} ${item.section} ${item.badge}`.toLowerCase();
                return q.split(/\s+/).every((term) => hay.includes(term));
              });

          if (matches.length === 0) {
            searchResults.innerHTML = `<div class="callout-box">No verified Valencia records matched "<strong>${q.replace(/[<>&"']/g, '')}</strong>". Try searching for <em>Sang-at</em>, <em>Badiang</em>, <em>Anoyon</em>, <em>Sto. Niño</em>, or a barangay name.</div>`;
            return;
          }

          searchResults.innerHTML = matches
            .map(
              (doc) => `
              <a href="${doc.url}" class="search-result-item">
                <div class="search-result-meta">
                  <span>${doc.section}</span>
                  <span>•</span>
                  <span>${doc.badge}</span>
                </div>
                <h3 class="search-result-title">${doc.title}</h3>
                <p class="search-result-summary">${doc.summary}</p>
              </a>
            `
            )
            .join('');
        }

        function setSearchModal(open) {
          if (!searchModal || !searchOpenBtn) return;
          if (open) {
            searchModal.removeAttribute('hidden');
            searchOpenBtn.setAttribute('aria-expanded', 'true');
            renderSearchResults(searchInput?.value || '');
            setTimeout(() => searchInput?.focus(), 20);
          } else {
            searchModal.setAttribute('hidden', '');
            searchOpenBtn.setAttribute('aria-expanded', 'false');
            searchOpenBtn.focus();
          }
        }

        searchOpenBtn?.addEventListener('click', () => setSearchModal(true));
        searchCloseBtn?.addEventListener('click', () => setSearchModal(false));
        searchModal?.addEventListener('click', (e) => {
          if (e.target === searchModal) setSearchModal(false);
        });
        searchInput?.addEventListener('input', (e) => {
          renderSearchResults(e.target.value);
        });

        window.addEventListener('keydown', (e) => {
          if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
            e.preventDefault();
            setSearchModal(true);
          } else if (e.key === 'Escape') {
            if (searchModal && !searchModal.hasAttribute('hidden')) {
              setSearchModal(false);
            } else if (mobileBackdrop && !mobileBackdrop.hasAttribute('hidden')) {
              setMobileDrawer(false);
            }
          }
        });
      })();
    </script>
  </body>
</html>
