---
import type { ServiceCategoryItem } from '../data/types';
interface Props {
  item: ServiceCategoryItem;
  index?: number;
}
const { item } = Astro.props;
---

<a class="service-card" href={`/services/${item.id}`}>
  <div class="service-card-head">
    <span class="service-office-badge">{item.office}</span>
    <span class="service-mode">{item.charterStatus}</span>
  </div>
  <h3>{item.title}</h3>
  <p>{item.summary}</p>
  <div class="service-card-foot">
    <span>View service guide & preparation</span>
  </div>
</a>
