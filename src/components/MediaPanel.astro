---
import { MEDIA_SLOTS } from '../data/media';

interface Props {
  slotId?: string;
  label?: string;
  variant?: 'main' | 'tile' | 'small';
  caption?: string;
  imageSrc?: string;
  imageAlt?: string;
  eager?: boolean;
}

const {
  slotId,
  label,
  variant = 'tile',
  caption,
  imageSrc,
  imageAlt,
  eager = true
} = Astro.props;

const slot = slotId ? MEDIA_SLOTS[slotId] : undefined;
const resolvedSrc = imageSrc || slot?.imageSrc || '/media/valencia/valencia-church-plaza.jpg';
const resolvedTitle = label || slot?.title || 'Valencia, Bohol';
const resolvedCaption = caption || slot?.barangay || 'Municipality of Valencia, Bohol';
const resolvedAlt = imageAlt || slot?.imageAlt || `${resolvedTitle} — ${resolvedCaption}`;
---

<figure class={`media-frame media-${variant}`}>
  <img
    src={resolvedSrc}
    alt={resolvedAlt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="sync"
  />
  <figcaption class="media-caption">
    <strong>{resolvedTitle}</strong>
    <span>{resolvedCaption}</span>
  </figcaption>
</figure>
