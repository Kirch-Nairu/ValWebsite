---
interface Props {label?:string;detail?:string;}
const {label='Verification notice',detail='This is a research-backed prototype. Confirm current procedures and official records with the municipal government before relying on them.'}=Astro.props;
---
<div class="status-notice" role="note"><span class="status-symbol" aria-hidden="true">i</span><div><strong>{label}</strong><p>{detail}</p></div></div>
