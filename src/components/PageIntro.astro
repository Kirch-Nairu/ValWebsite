---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  aside?: string;
  asideTitle?: string;
  variant?: 'stone' | 'forest' | 'banner';
  bgImage?: string;
}
const {
  eyebrow,
  title,
  description,
  aside,
  asideTitle = 'Office Guidance',
  variant = 'stone',
  bgImage
} = Astro.props;

const isForest = variant === 'forest';
const isBanner = variant === 'banner';
---

<section
  class={`page-intro ${isForest ? 'page-intro-forest' : isBanner ? 'page-intro-banner' : ''}`}
  style={bgImage ? `position: relative; background: #0a1f1b url('${bgImage}') center center / cover no-repeat; overflow: hidden;` : undefined}
>
  {bgImage && (
    <div
      style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10, 31, 27, 0.92) 0%, rgba(15, 45, 38, 0.86) 50%, rgba(10, 31, 27, 0.94) 100%); pointer-events: none;"
      aria-hidden="true"
    ></div>
  )}

  <div class="container page-intro-grid" style={bgImage ? 'position: relative; z-index: 1;' : undefined}>
    <div>
      {eyebrow && (
        <p class={`section-kicker ${isForest || isBanner || bgImage ? 'light' : ''}`} style="color: var(--valencia-orange); letter-spacing: 0.08em; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; margin-bottom: 6px;">
          {eyebrow}
        </p>
      )}
      <h1 style={isForest || isBanner || bgImage ? 'color: #ffffff;' : undefined}>{title}</h1>
      <p class="page-intro-description" style={isForest || isBanner || bgImage ? 'color: #d1e2db;' : undefined}>{description}</p>
    </div>
    {aside && (
      <div
        class="intro-aside"
        style={isForest || isBanner || bgImage ? 'background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.4); border-left: 4px solid var(--valencia-orange); box-shadow: 0 8px 24px rgba(0,0,0,0.18);' : 'border-left: 4px solid var(--valencia-orange);'}
      >
        <strong class="intro-aside-title" style="color: var(--forest); font-weight: 700; font-size: 0.82rem;">{asideTitle}</strong>
        <p style="color: #374151; font-size: 0.82rem; margin-top: 4px; line-height: 1.5;">{aside}</p>
      </div>
    )}
  </div>
</section>
