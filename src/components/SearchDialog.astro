---
import { SEARCH_INDEX } from '../data/search';
const basicPages = [
  { id: 'municipality', title: 'Municipality & 35 Barangays', url: '/municipality', summary: 'Municipal profile, geography, and barangay directory', section: 'Municipality' },
  { id: 'services', title: 'Municipal Services', url: '/services', summary: 'Civil registry, permits, treasury, health, and agriculture guides', section: 'Services' },
  { id: 'news', title: 'News & Announcements', url: '/news', summary: 'Dated municipal reports and community milestones', section: 'News' },
  { id: 'projects', title: 'Projects & Progress', url: '/projects', summary: 'Infrastructure turnovers, digital initiatives, and barangay programs', section: 'Projects' },
  { id: 'tourism', title: 'Tourism & Culture', url: '/tourism', summary: 'Badiang Spring, Sr. Santo Niño Church, hills, caves, and Sang-at Festival', section: 'Tourism' },
  { id: 'transparency', title: 'Transparency & Public Records', url: '/transparency', summary: 'DILG Full Disclosure Policy, PSA registry, and Bohol PPDO records', section: 'Transparency' },
  { id: 'contact', title: 'Contact & Directions', url: '/contact', summary: 'Official communication channels and Municipal Hall location', section: 'Contact' }
];
const records = [
  ...basicPages,
  ...SEARCH_INDEX.map((x) => ({
    id: x.id,
    title: x.title,
    url: x.url,
    summary: x.summary,
    section: x.section
  }))
];
---

<dialog id="site-search-dialog" class="search-dialog" data-records={JSON.stringify(records)} aria-label="Site search">
  <div class="search-top">
    <label for="global-search-input">Search Municipality of Valencia</label>
    <button id="search-close" type="button" aria-label="Close search">Close</button>
  </div>
  <div class="search-field">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-4-4" />
    </svg>
    <input
      id="global-search-input"
      type="search"
      placeholder="Search services, 35 barangays, projects, destinations, or news..."
      autocomplete="off"
    />
  </div>
  <p class="search-help">Find municipal services, barangays, public announcements, and landmarks across Valencia.</p>
  <div id="search-results" aria-live="polite" class="search-results"></div>
  <div class="search-bottom">
    <span>Press Esc to close</span>
    <a href="/search">Open full search directory</a>
  </div>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('#site-search-dialog');
  const field = document.querySelector<HTMLInputElement>('#global-search-input');
  const results = document.querySelector<HTMLElement>('#search-results');
  const closer = document.querySelector<HTMLButtonElement>('#search-close');
  if (dlg && field && results && closer) {
    const data = JSON.parse(dlg.dataset.records || '[]') as Array<{
      id: string;
      title: string;
      url: string;
      summary: string;
      section: string;
    }>;
    let previous: HTMLElement | null = null;
    const render = () => {
      results.replaceChildren();
      const q = field.value.trim().toLocaleLowerCase();
      const found = (
        q
          ? data.filter((x) => [x.title, x.summary, x.section].join(' ').toLocaleLowerCase().includes(q))
          : data.slice(0, 7)
      ).slice(0, 16);
      const count = document.createElement('p');
      count.className = 'search-count';
      count.textContent = q ? `${found.length} matching results` : 'Quick access';
      results.append(count);
      if (!found.length) {
        const none = document.createElement('p');
        none.textContent = 'No matching entries found. Try searching for a barangay name, service, or landmark.';
        results.append(none);
      }
      for (const item of found) {
        const a = document.createElement('a');
        a.href = item.url;
        const cat = document.createElement('span');
        cat.textContent = item.section;
        const title = document.createElement('strong');
        title.textContent = item.title;
        const small = document.createElement('small');
        small.textContent = item.summary;
        a.append(cat, title, small);
        results.append(a);
      }
    };
    document.querySelectorAll<HTMLElement>('[data-open-search]').forEach((btn) =>
      btn.addEventListener('click', () => {
        previous = btn;
        field.value = '';
        render();
        dlg.showModal();
        field.focus();
      })
    );
    field.addEventListener('input', render);
    dlg.addEventListener(
      'keydown',
      (event: KeyboardEvent) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          event.stopPropagation();
          dlg.close();
        }
      },
      true
    );
    closer.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (event) => {
      if (event.target === dlg) dlg.close();
    });
    dlg.addEventListener('close', () => previous?.focus());
  }
</script>
