---
const path = Astro.url.pathname;
const items = [
 {title:'Home', href:'/'}, {title:'Municipality',href:'/municipality'}, {title:'Government',href:'/government'},
 {title:'Services',href:'/services'}, {title:'News & Advisories',href:'/news'}, {title:'Projects',href:'/projects'},
 {title:'Tourism',href:'/tourism'}, {title:'Transparency',href:'/transparency'}
];
const selected=(href:string)=>href==='/'?path==='/':path===href||path.startsWith(href+'/');
---
<header class="site-header">
  <div class="container header-inner">
    <a class="identity" href="/" aria-label="Municipality of Valencia prototype homepage">
      <span class="identity-monogram" aria-hidden="true">V<span class="monogram-pip">.</span></span>
      <span class="identity-words"><strong>MUNICIPALITY OF VALENCIA</strong><span>BOHOL, PHILIPPINES <b class="identity-separator">/</b> BARUG VALENCIA</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {items.map(item=><a href={item.href} aria-current={selected(item.href)?'page':undefined}>{item.title}</a>)}
    </nav>
    <div class="header-actions">
      <button class="icon-button" type="button" data-open-search aria-label="Search the website" title="Search"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></button>
      <a class="header-contact" href="/contact">Contact <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-label="Open navigation" aria-controls="mobile-nav" aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<dialog class="mobile-dialog" id="mobile-nav" aria-label="Mobile navigation">
  <div class="mobile-dialog-head"><strong>MUNICIPALITY OF VALENCIA</strong><button type="button" id="menu-close" aria-label="Close navigation">Close ×</button></div>
  <nav aria-label="Mobile navigation" class="mobile-links">
    {items.map((item,i)=><a href={item.href} aria-current={selected(item.href)?'page':undefined}><span class="menu-index">{String(i+1).padStart(2,'0')}</span>{item.title}<span aria-hidden="true">↗</span></a>)}
    <a href="/contact"><span class="menu-index">09</span>Contact<span aria-hidden="true">↗</span></a>
  </nav>
  <p>Independent prototype · Not an official government transaction portal.</p>
</dialog>
<script>
  const menu = document.querySelector<HTMLDialogElement>('#mobile-nav');
  const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
  const close = document.querySelector<HTMLButtonElement>('#menu-close');
  if (menu && toggle && close) {
    toggle.addEventListener('click', () => {menu.showModal();toggle.setAttribute('aria-expanded','true');close.focus();});
    close.addEventListener('click', () => menu.close());
    menu.addEventListener('close', () => {toggle.setAttribute('aria-expanded','false');toggle.focus();});
    menu.addEventListener('click', e => {if(e.target===menu)menu.close();});
    menu.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>menu.close()));
  }
</script>
