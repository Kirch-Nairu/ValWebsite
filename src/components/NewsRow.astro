---
import type { UpdateItem } from '../data/types';
interface Props{item:UpdateItem;}
const {item}=Astro.props;
---
<a class="news-row" href={`/news/${item.slug}`}><time datetime={item.publishedDate}>{new Date(item.publishedDate+'T00:00:00').toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})}</time><div><span class="item-category">{item.category}</span><h3>{item.title}</h3><p>{item.summary}</p><small>Source: {item.publisher} · Archival record</small></div><span class="list-arrow" aria-hidden="true">↗</span></a>
